<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:u="https://irihi.tech/ursa"
             xmlns:local="using:HIS.Client.UrsaShell.Stations.IpdDoctor"
             xmlns:vm="using:HIS.Client.UrsaShell.ViewModels"
             x:Class="HIS.Client.UrsaShell.Stations.IpdDoctor.IpdDoctorView"
             x:DataType="local:IpdDoctorViewModel">
    <Grid ColumnDefinitions="286,*" Background="{DynamicResource SemiColorBackground0}">
        <!-- Left Inpatient Bed Sidebar -->
        <Border Grid.Column="0" Background="{DynamicResource SemiColorBackground1}"
                BorderBrush="{DynamicResource SemiColorBorder}" BorderThickness="0,0,1,0" Padding="12">
            <Grid RowDefinitions="Auto,Auto,*">
                <StackPanel Grid.Row="0" Spacing="3" Margin="2,0,0,12">
                    <TextBlock Text="住院患者" FontSize="17" FontWeight="Bold"/>
                    <TextBlock Text="选择床位联动全局患者横幅" FontSize="11" Foreground="{DynamicResource SemiColorText2}"/>
                </StackPanel>

                <Grid Grid.Row="1" ColumnDefinitions="*,*,*" Margin="0,0,0,10">
                    <Border Grid.Column="0" Background="{DynamicResource SemiColorPrimaryLight}" CornerRadius="5" Padding="8,6" Margin="0,0,4,0">
                        <StackPanel>
                            <TextBlock Text="在院" FontSize="11" Foreground="{DynamicResource SemiColorText2}"/>
                            <TextBlock Text="{Binding Workbench.TotalInpatientCount}" FontSize="19" FontWeight="Bold" Foreground="{DynamicResource SemiColorPrimary}"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Background="{DynamicResource SemiColorDangerLight}" CornerRadius="5" Padding="8,6" Margin="2,0">
                        <StackPanel>
                            <TextBlock Text="病危" FontSize="11" Foreground="{DynamicResource SemiColorText2}"/>
                            <TextBlock Text="{Binding Workbench.CriticalInpatientCount}" FontSize="19" FontWeight="Bold" Foreground="{DynamicResource SemiColorDanger}"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Background="{DynamicResource SemiColorWarningLight}" CornerRadius="5" Padding="8,6" Margin="4,0,0,0">
                        <StackPanel>
                            <TextBlock Text="待审" FontSize="11" Foreground="{DynamicResource SemiColorText2}"/>
                            <TextBlock Text="{Binding Workbench.PendingOrderReviewCount}" FontSize="19" FontWeight="Bold" Foreground="{DynamicResource SemiColorWarning}"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <ListBox Grid.Row="2" ItemsSource="{Binding Workbench.InpatientRecords}"
                         SelectedItem="{Binding Workbench.SelectedInpatient, Mode=TwoWay}"
                         Background="Transparent" BorderThickness="0">
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,0,0,7"/>
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </ListBox.Styles>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:InpatientRecordModel">
                            <Border Padding="11,10" CornerRadius="6" Width="248"
                                    Background="{DynamicResource SemiColorBackground0}"
                                    BorderBrush="{DynamicResource SemiColorBorder}" BorderThickness="1">
                                <StackPanel Spacing="6">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{Binding PatientName}" FontWeight="Bold" FontSize="14"/>
                                            <TextBlock Text="{Binding PatientStatus}" FontSize="11" FontWeight="Bold"
                                                       Foreground="{Binding PatientStatusBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding BedCode}" FontSize="11" FontWeight="Bold"
                                                   Foreground="{DynamicResource SemiColorPrimary}"/>
                                    </Grid>
                                    <TextBlock Text="{Binding PatientContext}" FontSize="11" Foreground="{DynamicResource SemiColorText2}"/>
                                    <TextBlock Text="{Binding Diagnosis}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0" Text="{Binding NursingLevel}" FontSize="11"
                                                   Foreground="{Binding NursingLevelBrush}" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Column="1" Text="{Binding DischargeGateSummary}" FontSize="11"
                                                   Foreground="{Binding DischargeGateBrush}"/>
                                    </Grid>
                                    <TextBlock Text="{Binding WorkflowSummary}" FontSize="11" Foreground="{DynamicResource SemiColorText2}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- Right Doctor Workspace -->
        <Grid Grid.Column="1" RowDefinitions="Auto,*">
            <Border Grid.Row="0" Background="{DynamicResource SemiColorBackground1}"
                    BorderBrush="{DynamicResource SemiColorBorder}" BorderThickness="0,0,0,1" Padding="18,12">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="3">
                        <StackPanel Orientation="Horizontal" Spacing="9">
                            <TextBlock Text="{Binding Workbench.SelectedInpatient.PatientName, FallbackValue='未选择住院患者'}"
                                       FontSize="18" FontWeight="Bold"/>
                            <TextBlock Text="{Binding Workbench.SelectedInpatient.PatientStatus}" FontSize="11"
                                       FontWeight="Bold" Foreground="{Binding Workbench.SelectedInpatient.PatientStatusBrush}"
                                       VerticalAlignment="Center"/>
                            <Border Background="{DynamicResource SemiColorDangerLight}" CornerRadius="4" Padding="6,2"
                                    IsVisible="{Binding Workbench.SelectedInpatient.HasAllergyAlert}">
                                <TextBlock Text="{Binding Workbench.SelectedInpatient.AllergySummary}" FontSize="11"
                                           Foreground="{DynamicResource SemiColorDanger}" FontWeight="SemiBold"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding Workbench.SelectedInpatient.PatientContext}" FontSize="11"
                                   Foreground="{DynamicResource SemiColorText2}"/>
                        <TextBlock Text="{Binding Workbench.SelectedInpatient.Diagnosis, StringFormat='{}诊断: {0}'}"
                                   FontSize="11" Foreground="{DynamicResource SemiColorText1}" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button Content="危急值双签收" Classes="Danger" Height="30" Padding="11,0"
                                Command="{Binding OpenCriticalValueCommand}"/>
                        <Button Content="办理新入院" Classes="Primary" Height="30" Padding="11,0"
                                Command="{Binding AdmitInpatientCommand}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <TabControl Grid.Row="1" Margin="14,12,14,14" SelectedIndex="{Binding SelectedWorkspaceIndex, Mode=TwoWay}">
                <!-- Tab 0: 医嘱管理 -->
                <TabItem Header="医嘱管理">
                    <Grid RowDefinitions="Auto,*">
                        <Border Grid.Row="0" Background="{DynamicResource SemiColorBackground1}" CornerRadius="7"
                                BorderBrush="{DynamicResource SemiColorBorder}" BorderThickness="1" Padding="14" Margin="0,0,0,10">
                            <StackPanel Spacing="9">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <TextBlock Text="住院医嘱开立与管理 (F2 聚焦 · Ctrl+Enter 下达长嘱)" FontSize="14" FontWeight="Bold"/>
                                        <TextBlock Text="住院医生开立长期/临时医嘱后，由病区责任护士校对审签并按频次时间点自动分解。"
                                                   FontSize="11" Foreground="{DynamicResource SemiColorText2}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                        <Button Content="+ 下达长期医嘱" Classes="Primary" Height="30" Padding="14,0"
                                                Command="{Binding AddLongOrderCommand}"/>
                                        <Button Content="+ 下达临时医嘱" Classes="Warning" Height="30" Padding="14,0"
                                                Command="{Binding AddTempOrderCommand}"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="{Binding OrderCreateBlockedReason}" FontSize="11" Foreground="{DynamicResource SemiColorWarning}"
                                           IsVisible="{Binding OrderCreateBlockedReason, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

                                <Grid ColumnDefinitions="2*,110,130,220">
                                    <u:FormItem Grid.Column="0" Label="医嘱内容 (药品/规格/诊疗/处置)" Margin="0,0,8,0">
                                        <TextBox x:Name="OrderContentInput" Text="{Binding Workbench.NewOrderContent, Mode=TwoWay}"
                                                 Height="30" PlaceholderText="输入药品名称规格或处置项目..."/>
                                    </u:FormItem>
                                    <u:FormItem Grid.Column="1" Label="单次剂量" Margin="0,0,8,0">
                                        <TextBox Text="{Binding Workbench.NewOrderDose, Mode=TwoWay}" Height="30" PlaceholderText="如 100mg/1支"/>
                                    </u:FormItem>
                                    <u:FormItem Grid.Column="2" Label="给药途径" Margin="0,0,8,0">
                                        <ComboBox ItemsSource="{Binding Workbench.OrderRouteOptions}"
                                                  SelectedItem="{Binding Workbench.NewOrderRoute, Mode=TwoWay}"
                                                  Height="30" HorizontalAlignment="Stretch"/>
                                    </u:FormItem>
                                    <u:FormItem Grid.Column="3" Label="执行频次 (含分解时间点)">
                                        <ComboBox ItemsSource="{Binding Workbench.OrderFrequencyOptions}"
                                                  SelectedItem="{Binding Workbench.NewOrderFrequency, Mode=TwoWay}"
                                                  Height="30" HorizontalAlignment="Stretch"/>
                                    </u:FormItem>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1" Background="{DynamicResource SemiColorBackground1}" CornerRadius="7"
                                BorderBrush="{DynamicResource SemiColorBorder}" BorderThickness="1" Padding="14">
                            <Grid RowDefinitions="Auto,*">
                                <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,8">
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <TextBlock Text="住院患者医嘱单" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <Button Content="全部医嘱" Height="26" Padding="8,0" Command="{Binding FilterOrdersCommand}" CommandParameter="ALL"/>
                                        <Button Content="长期医嘱单" Height="26" Padding="8,0" Command="{Binding FilterOrdersCommand}" CommandParameter="LONG"/>
                                        <Button Content="临时医嘱单" Height="26" Padding="8,0" Command="{Binding FilterOrdersCommand}" CommandParameter="TEMP"/>
                                        <Button Content="待审核医嘱" Height="26" Padding="8,0" Command="{Binding FilterOrdersCommand}" CommandParameter="PENDING"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Workbench.SelectedInpatient.ActiveOrderCount, StringFormat='{}有效: {0}'}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SemiColorPrimary}"/>
                                        <TextBlock Text="{Binding Workbench.SelectedInpatient.LongTermOrderCount, StringFormat='{}长期: {0}'}" FontSize="11" Foreground="{DynamicResource SemiColorText2}"/>
                                        <TextBlock Text="{Binding Workbench.SelectedInpatient.TempOrderCount, StringFormat='{}临时: {0}'}" FontSize="11" Foreground="{DynamicResource SemiColorText2}"/>
                                        <TextBlock Text="{Binding Workbench.SelectedInpatient.PendingOrderCount, StringFormat='{}待审: {0}'}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SemiColorWarning}"/>
                                    </StackPanel>
                                </Grid>

                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                                    <StackPanel MinWidth="1280">
                                        <Border Background="{DynamicResource SemiColorBackground2}" CornerRadius="4" Padding="10,6" Margin="0,0,0,6">
                                            <Grid ColumnDefinitions="80,128,*,70,70,118,70,90,90,128,70,100">
                                                <TextBlock Grid.Column="0" Text="类别" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource SemiColorText2}"/>
                                                <TextBlock Grid.Column="1" Text="起始时间" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource SemiColorText2}"/>
                                                <TextBlock Grid.Column="2" Text="医嘱内容与规格" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource SemiColorText2}"/>
                                                <TextBlock Grid.Column="3" Text="剂量" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource SemiColorText2}"/>
                                                <TextBlock Grid.Column="4" Text="途径" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource SemiColorText2}"/>
                                                <TextBlock Grid.Column="5" Text="频次" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource SemiColorText2}"/>
                                                <TextBlock Grid.Column="6" Text="医师" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource SemiColorText2}"/>
                                                <TextBlock Grid.Column="7" Text="状态" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource SemiColorText2}"/>
                                                <TextBlock Grid.Column="8" Text="校对护士" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource SemiColorText2}"/>
                                                <TextBlock Grid.Column="9" Text="停止时间" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource SemiColorText2}"/>
                                                <TextBlock Grid.Column="10" Text="停止医师" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource SemiColorText2}"/>
                                                <TextBlock Grid.Column="11" Text="操作" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource SemiColorText2}"/>
                                            </Grid>
                                        </Border>

                                        <ItemsControl ItemsSource="{Binding Workbench.SelectedInpatient.FilteredOrders}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:InpatientOrderModel">
                                                    <Border Padding="10,6" Margin="0,0,0,5" CornerRadius="5"
                                                            Background="{DynamicResource SemiColorBackground0}"
                                                            BorderBrush="{DynamicResource SemiColorBorder}" BorderThickness="1">
                                                        <Grid ColumnDefinitions="80,128,*,70,70,118,70,90,90,128,70,100">
                                                            <Border Grid.Column="0" Background="{DynamicResource SemiColorPrimaryLight}" CornerRadius="3"
                                                                    Padding="4,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding OrderType}" FontSize="12" FontWeight="Bold" Foreground="{Binding StatusBrush}"/>
                                                            </Border>
                                                            <TextBlock Grid.Column="1" Text="{Binding StartTime}" FontSize="12" Foreground="{DynamicResource SemiColorText2}" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="2" Text="{Binding Content}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="3" Text="{Binding Dose}" FontSize="12" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="4" Text="{Binding Route}" FontSize="12" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="5" Text="{Binding Frequency}" FontSize="12" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="6" Text="{Binding DoctorName}" FontSize="12" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="7" Text="{Binding Status}" FontSize="12" FontWeight="Bold" Foreground="{Binding StatusBrush}" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="8" Text="{Binding NurseSign}" FontSize="12" Foreground="{DynamicResource SemiColorText2}" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="9" Text="{Binding StopTime}" FontSize="12" Foreground="{DynamicResource SemiColorText3}" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="10" Text="{Binding StopDoctor}" FontSize="12" Foreground="{DynamicResource SemiColorText3}" VerticalAlignment="Center"/>
                                                            <StackPanel Grid.Column="11" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                                <Button Content="停止" Height="24" Padding="6,0" Classes="Secondary"
                                                                        IsVisible="{Binding CanStop}"
                                                                        Command="{Binding $parent[UserControl].((local:IpdDoctorViewModel)DataContext).StopOrderCommand}"
                                                                        CommandParameter="{Binding}"/>
                                                                <Button Content="作废" Height="24" Padding="6,0" Classes="Danger"
                                                                        IsVisible="{Binding CanCancel}"
                                                                        Command="{Binding $parent[UserControl].((local:IpdDoctorViewModel)DataContext).CancelOrderCommand}"
                                                                        CommandParameter="{Binding}"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- Tab 1: 查房与病程 -->
                <TabItem Header="查房与病程">
                    <Grid RowDefinitions="Auto,*">
                        <Border Grid.Row="0" Background="{DynamicResource SemiColorBackground1}" CornerRadius="7"
                                BorderBrush="{DynamicResource SemiColorBorder}" BorderThickness="1" Padding="14" Margin="0,0,0,10">
                            <StackPanel Spacing="9">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0" Spacing="3">
                                        <TextBlock Text="今日查房摘要" FontSize="13" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding Workbench.SelectedInpatient.DailySummary}" FontSize="11"
                                                   Foreground="{DynamicResource SemiColorText2}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="{DynamicResource SemiColorBackground2}"
                                            CornerRadius="5" Padding="10,7" Margin="14,0,0,0">
                                        <StackPanel>
                                            <TextBlock Text="主管医师" FontSize="11" Foreground="{DynamicResource SemiColorText2}"/>
                                            <TextBlock Text="{Binding Workbench.SelectedInpatient.AttendingDoctor}" FontSize="11" FontWeight="Bold"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <u:Divider Margin="0,1"/>
                                <TextBlock Text="新增病程记录 (Ctrl+S 保存)" FontSize="12" FontWeight="SemiBold"/>
                                <TextBox Text="{Binding Workbench.NewProgressNote, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap"
                                         PlaceholderText="记录患者症状、查体、检验结果及今日处理计划..."
                                         MinHeight="62"/>
                                <Grid ColumnDefinitions="*,Auto,Auto">
                                    <TextBlock Grid.Column="0" Text="提交后由主治医师完成终审签。"
                                               FontSize="11" Foreground="{DynamicResource SemiColorText2}" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Content="保存病程" Height="30" Padding="12,0"
                                            Margin="0,0,8,0" Command="{Binding AddProgressNoteCommand}"/>
                                    <Button Grid.Column="2" Content="审签最新病程" Classes="Primary" Height="30"
                                            Padding="12,0" Command="{Binding SignLatestProgressNoteCommand}"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1" Background="{DynamicResource SemiColorBackground1}" CornerRadius="7"
                                BorderBrush="{DynamicResource SemiColorBorder}" BorderThickness="1" Padding="14">
                            <Grid RowDefinitions="Auto,*">
                                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                                    <TextBlock Grid.Column="0" Text="病程记录" FontSize="13" FontWeight="Bold"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Workbench.SelectedInpatient.UnsignedNoteCount, StringFormat='{}{0} 份待审签'}"
                                               FontSize="11" Foreground="{DynamicResource SemiColorWarning}"/>
                                </Grid>
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl ItemsSource="{Binding Workbench.SelectedInpatient.ProgressNotes}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:ProgressNoteModel">
                                                <Border Padding="11" Margin="0,0,0,8" CornerRadius="6"
                                                        Background="{DynamicResource SemiColorBackground0}"
                                                        BorderBrush="{DynamicResource SemiColorBorder}" BorderThickness="1">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <StackPanel Grid.Column="0" Spacing="4">
                                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                                <TextBlock Text="{Binding RecordType}" FontWeight="Bold" FontSize="12"/>
                                                                <TextBlock Text="{Binding RecordTime}" FontSize="11" Foreground="{DynamicResource SemiColorText2}"/>
                                                                <TextBlock Text="{Binding Author}" FontSize="11" Foreground="{DynamicResource SemiColorText2}"/>
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding Content}" FontSize="11" TextWrapping="Wrap"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" Spacing="5" Margin="12,0,0,0">
                                                            <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="Bold"
                                                                       Foreground="{Binding StatusBrush}" HorizontalAlignment="Right"/>
                                                            <Button Content="审签" Height="25" Padding="8,0"
                                                                    IsVisible="{Binding !IsSigned}"
                                                                    Command="{Binding $parent[UserControl].((local:IpdDoctorViewModel)DataContext).SignNoteCommand}"
                                                                    CommandParameter="{Binding}"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- Tab 2: 审签与出院 -->
                <TabItem Header="审签与出院">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Spacing="10">
                            <Border Background="{DynamicResource SemiColorBackground1}" CornerRadius="7"
                                    BorderBrush="{DynamicResource SemiColorBorder}" BorderThickness="1" Padding="14">
                                <StackPanel Spacing="8">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0" Spacing="4">
                                            <TextBlock Text="出院六严关终审" FontSize="14" FontWeight="Bold"/>
                                            <TextBlock Text="医嘱闭环、医技归档、出院带药、病程审签、医保结算与预交金必须全部通过。"
                                                       FontSize="11" Foreground="{DynamicResource SemiColorText2}" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding Workbench.SelectedInpatient.DischargeGateSummary}" FontSize="12"
                                                       FontWeight="Bold" Foreground="{Binding Workbench.SelectedInpatient.DischargeGateBrush}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                            <Button Content="查看六严关详情 (F3)" Classes="Warning" Height="30" Padding="11,0"
                                                    Command="{Binding OpenDischargeCheckCommand}"/>
                                            <Button Content="提交出院申请" Classes="Primary" Height="30" Padding="11,0"
                                                    Command="{Binding ApproveDischargeCommand}"/>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="{Binding DischargeBlockedReason}" FontSize="11" Foreground="{DynamicResource SemiColorWarning}"
                                               TextWrapping="Wrap"
                                               IsVisible="{Binding DischargeBlockedReason, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                </StackPanel>
                            </Border>

                            <Border Background="{DynamicResource SemiColorBackground1}" CornerRadius="7"
                                    BorderBrush="{DynamicResource SemiColorBorder}" BorderThickness="1" Padding="14">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="六严关状态" FontSize="13" FontWeight="Bold"/>
                                    <Border Background="{DynamicResource SemiColorBackground0}" CornerRadius="5" Padding="10,8">
                                        <Grid ColumnDefinitions="180,*">
                                            <TextBlock Grid.Column="0" Text="1  医嘱闭环" FontSize="11" FontWeight="SemiBold"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Workbench.DischargeCheckDetails.OrdersGateText}"
                                                       FontSize="11" Foreground="{Binding Workbench.DischargeCheckDetails.OrdersGateBrush}"/>
                                        </Grid>
                                    </Border>
                                    <Border Background="{DynamicResource SemiColorBackground0}" CornerRadius="5" Padding="10,8">
                                        <Grid ColumnDefinitions="180,*">
                                            <TextBlock Grid.Column="0" Text="2  医技报告归档" FontSize="11" FontWeight="SemiBold"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Workbench.DischargeCheckDetails.MedTechGateText}"
                                                       FontSize="11" Foreground="{Binding Workbench.DischargeCheckDetails.MedTechGateBrush}"/>
                                        </Grid>
                                    </Border>
                                    <Border Background="{DynamicResource SemiColorBackground0}" CornerRadius="5" Padding="10,8">
                                        <Grid ColumnDefinitions="180,*">
                                            <TextBlock Grid.Column="0" Text="3  出院带药配发" FontSize="11" FontWeight="SemiBold"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Workbench.DischargeCheckDetails.MedsGateText}"
                                                       FontSize="11" Foreground="{Binding Workbench.DischargeCheckDetails.MedsGateBrush}"/>
                                        </Grid>
                                    </Border>
                                    <Border Background="{DynamicResource SemiColorBackground0}" CornerRadius="5" Padding="10,8">
                                        <Grid ColumnDefinitions="180,*">
                                            <TextBlock Grid.Column="0" Text="4  病程全部审签" FontSize="11" FontWeight="SemiBold"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Workbench.DischargeCheckDetails.EmrGateText}"
                                                       FontSize="11" Foreground="{Binding Workbench.DischargeCheckDetails.EmrGateBrush}"/>
                                        </Grid>
                                    </Border>
                                    <Border Background="{DynamicResource SemiColorBackground0}" CornerRadius="5" Padding="10,8">
                                        <Grid ColumnDefinitions="180,*">
                                            <TextBlock Grid.Column="0" Text="5  医保结算核验" FontSize="11" FontWeight="SemiBold"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Workbench.DischargeCheckDetails.InsuranceGateText}"
                                                       FontSize="11" Foreground="{Binding Workbench.DischargeCheckDetails.InsuranceGateBrush}"/>
                                        </Grid>
                                    </Border>
                                    <Border Background="{DynamicResource SemiColorBackground0}" CornerRadius="5" Padding="10,8">
                                        <Grid ColumnDefinitions="180,*">
                                            <TextBlock Grid.Column="0" Text="6  预交金结清" FontSize="11" FontWeight="SemiBold"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Workbench.DischargeCheckDetails.PrepaymentGateText}"
                                                       FontSize="11" Foreground="{Binding Workbench.DischargeCheckDetails.PrepaymentGateBrush}"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <Border Background="{DynamicResource SemiColorBackground1}" CornerRadius="7"
                                    BorderBrush="{DynamicResource SemiColorBorder}" BorderThickness="1" Padding="14">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="住院流程闭环" FontSize="13" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding Workbench.SelectedInpatient.WorkflowCounts}" FontSize="11"
                                               Foreground="{DynamicResource SemiColorText2}"/>
                                    <TextBlock Text="出院终审只在六严关全部通过后开放。未通过时按钮保持锁定，避免漏费与带药差错。"
                                               FontSize="11" Foreground="{DynamicResource SemiColorText2}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</UserControl>

