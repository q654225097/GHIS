<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:HIS.Client.UrsaShell.Shell.Controls"
             xmlns:u="https://irihi.tech/ursa"
             xmlns:local="using:HIS.Client.UrsaShell.Stations.IpdDoctor"
             xmlns:vm="using:HIS.Client.UrsaShell.ViewModels"
             x:Class="HIS.Client.UrsaShell.Stations.IpdDoctor.IpdDoctorView"
             x:DataType="local:IpdDoctorViewModel">
    <Grid ColumnDefinitions="286,*" Background="{DynamicResource SemiColorBackground0}">
        <!-- Left Inpatient Bed Sidebar -->
        <Border Grid.Column="0" Background="{DynamicResource SemiColorBackground1}"
                BorderBrush="{DynamicResource SemiColorBorder}" BorderThickness="0,0,1,0" Padding="12">
            <Grid RowDefinitions="Auto,Auto,*">
                <StackPanel Grid.Row="0" Spacing="3" Margin="2,0,0,12">
                    <TextBlock Text="住院患者" FontSize="17" FontWeight="Bold"/>
                    <TextBlock Text="选择床位联动医嘱与病程" FontSize="11" Foreground="{DynamicResource SemiColorText2}"/>
                </StackPanel>

                <Grid Grid.Row="1" ColumnDefinitions="*,*,*" Margin="0,0,0,10">
                    <Border Grid.Column="0" Background="{DynamicResource SemiColorPrimaryLight}" CornerRadius="5" Padding="8,6" Margin="0,0,4,0">
                        <StackPanel>
                            <TextBlock Text="在院" FontSize="11" Foreground="{DynamicResource SemiColorText2}"/>
                            <TextBlock Text="{Binding Workbench.TotalInpatientCount}" FontSize="19" FontWeight="Bold" Foreground="{DynamicResource SemiColorPrimary}"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Background="{DynamicResource SemiColorDangerLight}" CornerRadius="5" Padding="8,6" Margin="2,0">
                        <StackPanel>
                            <TextBlock Text="病危" FontSize="11" Foreground="{DynamicResource SemiColorText2}"/>
                            <TextBlock Text="{Binding Workbench.CriticalInpatientCount}" FontSize="19" FontWeight="Bold" Foreground="{DynamicResource SemiColorDanger}"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Background="{DynamicResource SemiColorWarningLight}" CornerRadius="5" Padding="8,6" Margin="4,0,0,0">
                        <StackPanel>
                            <TextBlock Text="待审" FontSize="11" Foreground="{DynamicResource SemiColorText2}"/>
                            <TextBlock Text="{Binding Workbench.PendingOrderReviewCount}" FontSize="19" FontWeight="Bold" Foreground="{DynamicResource SemiColorWarning}"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <ListBox Grid.Row="2" ItemsSource="{Binding Workbench.InpatientRecords}"
                         SelectedItem="{Binding Workbench.SelectedInpatient, Mode=TwoWay}"
                         Background="Transparent" BorderThickness="0">
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,0,0,7"/>
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </ListBox.Styles>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:InpatientRecordModel">
                            <Border Padding="11,10" CornerRadius="6" Width="248"
                                    Background="{DynamicResource SemiColorBackground0}"
                                    BorderBrush="{DynamicResource SemiColorBorder}" BorderThickness="1">
                                <StackPanel Spacing="6">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{Binding PatientName}" FontWeight="Bold" FontSize="14"/>
                                            <TextBlock Text="{Binding PatientStatus}" FontSize="11" FontWeight="Bold"
                                                       Foreground="{Binding PatientStatusBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding BedCode}" FontSize="11" FontWeight="Bold"
                                                   Foreground="{DynamicResource SemiColorPrimary}"/>
                                    </Grid>
                                    <TextBlock Text="{Binding PatientContext}" FontSize="11" Foreground="{DynamicResource SemiColorText2}"/>
                                    <TextBlock Text="{Binding Diagnosis}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0" Text="{Binding NursingLevel}" FontSize="11"
                                                   Foreground="{Binding NursingLevelBrush}" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Column="1" Text="{Binding AvailableBalanceText}" FontSize="11"
                                                   Foreground="{DynamicResource SemiColorDanger}" FontWeight="Bold"/>
                                    </Grid>
                                    <TextBlock Text="{Binding WorkflowSummary}" FontSize="11" Foreground="{DynamicResource SemiColorText2}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- Right Doctor Workspace -->
        <Grid Grid.Column="1" RowDefinitions="Auto,*">
            <!-- Top Inpatient Patient Banner (Strictly Matching Screenshot 2) -->
            <Border Grid.Row="0"
                    Background="#D0EFFC"
                    BorderBrush="#93D5ED"
                    BorderThickness="0,0,0,1"
                    Padding="14,8">
                <StackPanel Spacing="4">
                    <!-- Line 1: 收起 / 床号 / 余额(欠费红字) / 性别 / 年龄 / 费别 / 住院号 / 住院天数 / 右侧图例 -->
                    <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,*,Auto">
                        <Button Grid.Column="0"
                                Content="{Binding Workbench.SelectedInpatient.BannerExpandText, FallbackValue='收起'}"
                                Classes="Tertiary"
                                Foreground="#C53030"
                                FontWeight="Bold"
                                FontSize="13"
                                Padding="2,0"
                                Margin="0,0,12,0"
                                VerticalAlignment="Center"
                                Command="{Binding ToggleBannerExpandCommand}"/>

                        <TextBlock Grid.Column="1"
                                   Text="{Binding Workbench.SelectedInpatient.BedCode, FallbackValue='018床(2F)'}"
                                   FontWeight="Bold"
                                   FontSize="14"
                                   Foreground="#C53030"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,0"/>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="可用余额: " FontSize="14" FontWeight="Bold" Foreground="#C53030"/>
                            <TextBlock Text="{Binding Workbench.SelectedInpatient.AvailableBalanceText, FallbackValue='-23550cs'}"
                                       FontSize="14" FontWeight="Bold" Foreground="#C53030"/>
                        </StackPanel>

                        <TextBlock Grid.Column="3"
                                   Text="{Binding Workbench.SelectedInpatient.Gender, FallbackValue='女'}"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Foreground="#C53030"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,0"/>

                        <TextBlock Grid.Column="4"
                                   Text="{Binding Workbench.SelectedInpatient.Age, StringFormat='{}{0}岁', FallbackValue='1岁'}"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Foreground="#C53030"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,0"/>

                        <TextBlock Grid.Column="5"
                                   Text="{Binding Workbench.SelectedInpatient.PaymentType, FallbackValue='自费'}"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Foreground="#C53030"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,0"/>

                        <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="住院号: " FontSize="13" FontWeight="Bold" Foreground="#C53030"/>
                            <TextBlock Text="{Binding Workbench.SelectedInpatient.AdmissionNo, FallbackValue='0000000001'}"
                                       FontSize="13" FontWeight="Bold" Foreground="#C53030"/>
                            <TextBlock Text="  " FontSize="13"/>
                            <TextBlock Text="{Binding Workbench.SelectedInpatient.StayDays, StringFormat='住院 {0} 天', FallbackValue='住院 157 天'}"
                                       FontSize="13" FontWeight="Bold" Foreground="#C53030"/>
                        </StackPanel>

                        <!-- Top Right Legend strictly matching Screenshot 2 (Two-line compact deep slate) -->
                        <StackPanel Grid.Column="8" VerticalAlignment="Top" HorizontalAlignment="Right" Spacing="1">
                            <TextBlock Text="绿色: 新开, 蓝色: 审核, 黄色:" FontSize="11" Foreground="#005580" FontWeight="SemiBold"/>
                            <TextBlock Text="执行, 红色: 停止" FontSize="11" Foreground="#005580" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Grid>

                    <!-- Expandable Details: Exactly 3 lines with bracketed labels matching Screenshot 2 -->
                    <StackPanel Spacing="3" IsVisible="{Binding Workbench.SelectedInpatient.IsBannerExpanded, FallbackValue=True}">
                        <!-- Line 2: [费用总额: ...] [押金总额: ...] [医保统筹: ...] [住院号: ...] [床号: ...] [诊断: ...] -->
                        <WrapPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Workbench.SelectedInpatient.TotalCostDisplay, FallbackValue='[费用总额: 23550]'}" FontSize="12" Foreground="#C53030" Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding Workbench.SelectedInpatient.DepositTotalDisplay, FallbackValue='[押金总额: 0]'}" FontSize="12" Foreground="#C53030" Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding Workbench.SelectedInpatient.InsuranceCoordinationDisplay, FallbackValue='[医保统筹: 0]'}" FontSize="12" Foreground="#C53030" Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding Workbench.SelectedInpatient.AdmissionNoDisplay, FallbackValue='[住院号: 0000000001]'}" FontSize="12" Foreground="#C53030" Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding Workbench.SelectedInpatient.BedCodeDisplay, FallbackValue='[床号: 018]'}" FontSize="12" Foreground="#C53030" Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding Workbench.SelectedInpatient.DiagnosisDisplay, FallbackValue='[诊断: 胸腺脓肿]'}" FontSize="12" Foreground="#C53030"/>
                        </WrapPanel>
                        <!-- Line 3: [入院日期: ...] [家庭住址: ...] [电话: ] -->
                        <WrapPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Workbench.SelectedInpatient.AdmissionDateDisplay, FallbackValue='[入院日期: 2026-06-15]'}" FontSize="12" Foreground="#C53030" Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding Workbench.SelectedInpatient.HomeAddressDisplay, FallbackValue='[家庭住址: ---]'}" FontSize="12" Foreground="#C53030" Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding Workbench.SelectedInpatient.ContactPhoneDisplay, FallbackValue='[电话:]'}" FontSize="12" Foreground="#C53030"/>
                        </WrapPanel>
                        <!-- Line 4: [身份证] [身高] [体重] -->
                        <WrapPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Workbench.SelectedInpatient.IdCardDisplay, FallbackValue='[身份证]'}" FontSize="12" Foreground="#C53030" Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding Workbench.SelectedInpatient.HeightDisplay, FallbackValue='[身高]'}" FontSize="12" Foreground="#C53030" Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding Workbench.SelectedInpatient.WeightDisplay, FallbackValue='[体重]'}" FontSize="12" Foreground="#C53030"/>
                        </WrapPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Main Workspaces Tabs -->
            <TabControl Grid.Row="1" Margin="10,8,10,10" SelectedIndex="{Binding SelectedWorkspaceIndex, Mode=TwoWay}">
                <!-- Tab 0: 医嘱管理 (住院医嘱开立与全要素表格) -->
                <TabItem Header="医嘱管理">
                    <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="8">
                        <!-- Top Quick Order Entry Bar (Strictly Matching Screenshot 1) -->
                        <Border Grid.Row="0"
                                Background="#DCF8E6"
                                BorderBrush="#A7D8B5"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="8,6">
                            <Border.Styles>
                                <Style Selector="TextBlock">
                                    <Setter Property="Foreground" Value="#111827"/>
                                    <Setter Property="FontSize" Value="12"/>
                                </Style>
                                <Style Selector="TextBox">
                                    <Setter Property="Background" Value="#FFFFFF"/>
                                    <Setter Property="Foreground" Value="#111827"/>
                                    <Setter Property="BorderBrush" Value="#9CA3AF"/>
                                </Style>
                                <Style Selector="ComboBox">
                                    <Setter Property="Background" Value="#FFFFFF"/>
                                    <Setter Property="Foreground" Value="#111827"/>
                                    <Setter Property="BorderBrush" Value="#9CA3AF"/>
                                </Style>
                                <Style Selector="u|NumericIntUpDown">
                                    <Setter Property="Background" Value="#FFFFFF"/>
                                    <Setter Property="Foreground" Value="#111827"/>
                                    <Setter Property="BorderBrush" Value="#9CA3AF"/>
                                </Style>
                                <Style Selector="u|NumericDoubleUpDown">
                                    <Setter Property="Background" Value="#FFFFFF"/>
                                    <Setter Property="Foreground" Value="#111827"/>
                                    <Setter Property="BorderBrush" Value="#9CA3AF"/>
                                </Style>
                            </Border.Styles>
                            <StackPanel Spacing="5">
                                <!-- Row 1: [全部 v] [简拼] 名称: [亮黄输入框] 数量 [ ^v] [ 单位 v] [亮黄规格/金额] [+ 录入 (Enter)] -->
                                <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="6">
                                    <ComboBox Grid.Column="0"
                                              ItemsSource="{Binding ItemCategoryOptions}"
                                              SelectedItem="{Binding SelectedItemCategory, Mode=TwoWay}"
                                              Width="80" Height="28" FontSize="12"/>

                                    <TextBox Grid.Column="1"
                                             Text="{Binding QuickSearchCode, Mode=TwoWay}"
                                             PlaceholderText="简拼"
                                             Width="70" Height="28" FontSize="12"/>

                                    <TextBlock Grid.Column="2" Text="名称:" FontSize="12" VerticalAlignment="Center" Margin="2,0"/>

                                    <!-- Drug / Item Search with Bright Yellow Highlight Box (Strictly Matching Screenshot 1) -->
                                    <Grid Grid.Column="3">
                                        <TextBox x:Name="OrderContentInput"
                                                 Text="{Binding OrderContentInput, Mode=TwoWay}"
                                                 PlaceholderText="输入药品或项目名称快速检索 (按 / 或 F2 聚焦)..."
                                                 Background="#FFFF55"
                                                 Foreground="#000000"
                                                 FontWeight="Bold"
                                                 Height="28"
                                                 FontSize="12"/>
                                        <Popup PlacementTarget="{Binding #OrderContentInput}"
                                               Placement="BottomEdgeAlignedLeft"
                                               IsOpen="{Binding IsDrugDropdownOpen, Mode=TwoWay}"
                                               IsLightDismissEnabled="True">
                                            <Border Width="650"
                                                    MaxHeight="300"
                                                    Background="{DynamicResource SemiColorBackground0}"
                                                    BorderBrush="{DynamicResource SemiColorPrimary}"
                                                    BorderThickness="1.5"
                                                    CornerRadius="8"
                                                    Padding="6"
                                                    BoxShadow="0 6 20 0 #26000000">
                                                <ScrollViewer MaxHeight="280">
                                                    <ItemsControl ItemsSource="{Binding FilteredDrugCatalog}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="vm:DrugCatalogItemModel">
                                                                <Button Classes="Tertiary"
                                                                        HorizontalAlignment="Stretch"
                                                                        HorizontalContentAlignment="Stretch"
                                                                        Padding="8,6"
                                                                        Command="{Binding $parent[UserControl].((local:IpdDoctorViewModel)DataContext).AddDrugCatalogItemCommand}"
                                                                        CommandParameter="{Binding}">
                                                                    <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="10">
                                                                        <StackPanel Grid.Column="0" Spacing="1">
                                                                            <TextBlock Text="{Binding DrugName}" FontWeight="Bold" FontSize="12"/>
                                                                            <TextBlock Text="{Binding Spec}" FontSize="11" Foreground="{DynamicResource SemiColorText2}"/>
                                                                        </StackPanel>
                                                                        <Border Grid.Column="1" Background="{DynamicResource SemiColorDangerLight}" CornerRadius="3" Padding="4,1" IsVisible="{Binding IsSkinTestRequired}">
                                                                            <TextBlock Text="需皮试" Foreground="{DynamicResource SemiColorDanger}" FontSize="10" FontWeight="Bold"/>
                                                                        </Border>
                                                                        <TextBlock Grid.Column="2" Text="{Binding UnitPrice}" FontWeight="SemiBold" Foreground="{DynamicResource SemiColorDanger}" VerticalAlignment="Center"/>
                                                                        <TextBlock Grid.Column="3" Text="{Binding StockQuantity, StringFormat='{}库存: {0}'}" FontSize="11" Foreground="{DynamicResource SemiColorSuccess}" VerticalAlignment="Center"/>
                                                                    </Grid>
                                                                </Button>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </ScrollViewer>
                                            </Border>
                                        </Popup>
                                    </Grid>

                                    <TextBlock Grid.Column="4" Text="数量" FontSize="12" VerticalAlignment="Center" Margin="2,0"/>

                                    <u:NumericIntUpDown Grid.Column="5"
                                                        Value="{Binding QuantityInput, Mode=TwoWay}"
                                                        Minimum="1" Maximum="999"
                                                        Width="60" Height="28" FontSize="12"/>

                                    <ComboBox Grid.Column="6"
                                              ItemsSource="{Binding TotalUnitOptions}"
                                              SelectedItem="{Binding SelectedTotalUnit, Mode=TwoWay}"
                                              Width="60" Height="28" FontSize="12"/>

                                    <!-- Right Yellow Highlight Box: Specification or Amount (Strictly Matching Screenshot 1) -->
                                    <TextBox Grid.Column="7"
                                             Text="{Binding QuickOrderSpecOrAmountText, Mode=OneWay}"
                                             IsReadOnly="True"
                                             Background="#FFFF55"
                                             Foreground="#000000"
                                             FontWeight="Bold"
                                             Width="95" Height="28" FontSize="12"
                                             TextAlignment="Center"/>

                                    <Button Grid.Column="8"
                                            Content="+ 录入 (Enter)"
                                            Classes="Primary"
                                            Height="28"
                                            Padding="12,0"
                                            FontWeight="Bold"
                                            Command="{Binding AddQuickOrderCommand}"/>
                                </Grid>

                                <!-- Row 2: 加急 / 每次用量: [ 1 ] [片] = [ 0.000 ] [g] / 用法 / 频次 / 天数 / 备注 / 耗材扣库科室 -->
                                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <CheckBox IsChecked="{Binding IsUrgentInput, Mode=TwoWay}"
                                              Content="加急"
                                              Foreground="#DC2626"
                                              FontWeight="Bold"
                                              FontSize="12"
                                              VerticalAlignment="Center"
                                              Margin="0,0,10,0"/>

                                    <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center" Margin="0,0,10,0">
                                        <TextBlock Text="每次用量:" FontSize="12" VerticalAlignment="Center"/>
                                        <u:NumericDoubleUpDown Value="{Binding SingleDoseInput, Mode=TwoWay}"
                                                               Minimum="0.01" Maximum="9999" Step="1"
                                                               Width="55" Height="26" FontSize="12"/>
                                        <ComboBox ItemsSource="{Binding DoseUnitOptions}"
                                                  SelectedItem="{Binding SelectedDoseUnit, Mode=TwoWay}"
                                                  Width="55" Height="26" FontSize="12"/>
                                        <TextBlock Text="=" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" Margin="3,0"/>
                                        <TextBox Text="{Binding SingleDoseEquivInput, Mode=TwoWay}"
                                                 Width="60" Height="26" FontSize="12" TextAlignment="Center"/>
                                        <ComboBox ItemsSource="{Binding SingleDoseEquivUnitOptions}"
                                                  SelectedItem="{Binding SingleDoseEquivUnitInput, Mode=TwoWay}"
                                                  Width="55" Height="26" FontSize="12"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center" Margin="0,0,10,0">
                                        <TextBlock Text="用法:" FontSize="12" VerticalAlignment="Center"/>
                                        <ComboBox ItemsSource="{Binding RouteOptions}"
                                                  SelectedItem="{Binding SelectedRoute, Mode=TwoWay}"
                                                  Width="105" Height="26" FontSize="12"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center" Margin="0,0,10,0">
                                        <TextBlock Text="频次:" FontSize="12" VerticalAlignment="Center"/>
                                        <ComboBox ItemsSource="{Binding FrequencyOptions}"
                                                  SelectedItem="{Binding SelectedFrequency, Mode=TwoWay}"
                                                  Width="100" Height="26" FontSize="12"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center" Margin="0,0,10,0">
                                        <TextBlock Text="天数:" FontSize="12" VerticalAlignment="Center"/>
                                        <u:NumericIntUpDown Value="{Binding DaysInput, Mode=TwoWay}"
                                                            Minimum="1" Maximum="90"
                                                            Width="55" Height="26" FontSize="12"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center" Margin="0,0,10,0">
                                        <TextBlock Text="备注:" FontSize="12" VerticalAlignment="Center"/>
                                        <TextBox Text="{Binding RemarkInput, Mode=TwoWay}"
                                                 PlaceholderText="医嘱备注"
                                                 Width="90" Height="26" FontSize="12"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="耗材扣库科室:" FontSize="12" VerticalAlignment="Center"/>
                                        <ComboBox ItemsSource="{Binding DeductDeptOptions}"
                                                  SelectedItem="{Binding SelectedDeductDept, Mode=TwoWay}"
                                                  Foreground="#1D4ED8"
                                                  FontWeight="Bold"
                                                  Width="115" Height="26" FontSize="12"/>
                                    </StackPanel>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- Actions & Defense Strip (Featuring [常] 常用组套, [设] 设置, 成组, 审方, 提交) -->
                        <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
                                <Button Content="成组 ┓┃┛" Classes="Secondary" Height="28" Padding="10,0" FontSize="11" FontWeight="Bold"
                                        Command="{Binding GroupSelectedOrdersCommand}"
                                        ToolTip.Tip="将勾选的多条输液医嘱合并为同一配伍组"/>
                                <Button Content="解组" Classes="Tertiary" Height="28" Padding="8,0" FontSize="11"
                                        Command="{Binding UngroupSelectedOrdersCommand}"/>
                                <ComboBox ItemsSource="{Binding CommonOrderSets}"
                                          SelectedItem="{Binding SelectedCommonOrderSet, Mode=TwoWay}"
                                          PlaceholderText="📋 [常] 常用医嘱组套调入..."
                                          Width="230" Height="28" FontSize="11">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="local:CommonOrderSetItem">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <Border Background="#2563EB" CornerRadius="3" Padding="4,1">
                                                    <TextBlock Text="{Binding Category}" FontSize="10" Foreground="White" FontWeight="Bold"/>
                                                </Border>
                                                <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <Button Content="需皮试" Classes="Warning" Height="28" Padding="8,0" FontSize="11"
                                        Command="{Binding QuickSetSkinTestCommand}" CommandParameter="需皮试"/>
                                <Button Content="皮试阴性 (-)" Classes="Success" Height="28" Padding="8,0" FontSize="11"
                                        Command="{Binding QuickSetSkinTestCommand}" CommandParameter="阴性 (-)"/>
                                <Button Content="皮试阳性 (+)" Classes="Danger" Height="28" Padding="8,0" FontSize="11"
                                        Command="{Binding QuickSetSkinTestCommand}" CommandParameter="阳性 (+)"/>
                                <Button Content="免试" Classes="Tertiary" Height="28" Padding="8,0" FontSize="11"
                                        Command="{Binding QuickSetSkinTestCommand}" CommandParameter="免试"/>
                                <Button Content="切换加急" Classes="Secondary" Height="28" Padding="8,0" FontSize="11"
                                        Command="{Binding ToggleUrgentCommand}"/>
                            </StackPanel>

                            <TextBlock Grid.Column="1"
                                       Text="{Binding OrderCreateBlockedReason}"
                                       FontSize="11"
                                       Foreground="{DynamicResource SemiColorWarning}"
                                       VerticalAlignment="Center"
                                       Margin="12,0"/>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                                <Button Content="🛡 6维度前置审方"
                                        Classes="Secondary"
                                        Height="28"
                                        Padding="12,0"
                                        FontSize="11"
                                        Command="{Binding PreCheckOrdersCommand}"/>
                                <Button Content="提交护士校对 (Ctrl+Enter)"
                                        Classes="Primary"
                                        Height="28"
                                        Padding="14,0"
                                        FontSize="11"
                                        FontWeight="Bold"
                                        Command="{Binding SubmitOrdersToNurseCommand}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Comprehensive Clinical Inpatient Order Grid with Left "组套" Drawer (Strictly Matching Screenshot 2 & 3) -->
                        <Grid Grid.Row="2" ColumnDefinitions="Auto,Auto,*">
                            <!-- Left Vertical "组套" Button strictly matching Screenshot 2 & 3 -->
                            <Border Grid.Column="0"
                                    Background="#EFF6FF"
                                    BorderBrush="#BAE6FD"
                                    BorderThickness="1,1,0,1"
                                    CornerRadius="4,0,0,4"
                                    Width="22"
                                    VerticalAlignment="Top"
                                    Margin="0,6,0,0">
                                <Button Classes="Tertiary"
                                        Padding="0,8"
                                        Width="20"
                                        HorizontalAlignment="Center"
                                        Command="{Binding ToggleOrderSetsDrawerCommand}"
                                        ToolTip.Tip="点击展开/收起常用医嘱组套与个人模板">
                                    <StackPanel Spacing="3" HorizontalAlignment="Center">
                                        <TextBlock Text="组" FontSize="11" FontWeight="Bold" Foreground="#0284C7" HorizontalAlignment="Center"/>
                                        <TextBlock Text="套" FontSize="11" FontWeight="Bold" Foreground="#0284C7" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Border>

                            <!-- Collapsible 组套 Slide-out Drawer Panel -->
                            <Border Grid.Column="1"
                                    Width="260"
                                    Background="{DynamicResource SemiColorBackground0}"
                                    BorderBrush="{DynamicResource SemiColorBorder}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="8"
                                    Margin="0,0,6,0"
                                    IsVisible="{Binding IsOrderSetsDrawerOpen}">
                                <Grid RowDefinitions="Auto,*">
                                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                                        <TextBlock Grid.Column="0" Text="常用医嘱组套与科室模板" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource SemiColorPrimary}"/>
                                        <Button Grid.Column="1" Content="✕" Classes="Tertiary" Padding="4,0" FontSize="10" Command="{Binding ToggleOrderSetsDrawerCommand}"/>
                                    </Grid>
                                    <ScrollViewer Grid.Row="1" MaxHeight="450">
                                        <ItemsControl ItemsSource="{Binding CommonOrderSets}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="local:CommonOrderSetItem">
                                                    <Border Margin="0,0,0,6" Padding="6" Background="{DynamicResource SemiColorBackground1}" CornerRadius="4" BorderBrush="{DynamicResource SemiColorBorder}" BorderThickness="1">
                                                        <StackPanel Spacing="4">
                                                            <Grid ColumnDefinitions="*,Auto">
                                                                <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="Bold" FontSize="11"/>
                                                                <Border Grid.Column="1" Background="#2563EB" CornerRadius="3" Padding="4,1">
                                                                    <TextBlock Text="{Binding Category}" FontSize="9" Foreground="White" FontWeight="Bold"/>
                                                                </Border>
                                                            </Grid>
                                                            <TextBlock Text="{Binding Description}" FontSize="10" Foreground="{DynamicResource SemiColorText2}" TextWrapping="Wrap"/>
                                                            <Button Content="调入全部医嘱" Classes="Primary" Height="22" Padding="6,0" FontSize="10"
                                                                    Command="{Binding $parent[UserControl].((local:IpdDoctorViewModel)DataContext).ApplyCommonOrderSetCommand}"
                                                                    CommandParameter="{Binding}"/>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </Border>

                            <!-- Main Order Table (All 40 Columns from Screenshot 1, 2, 3) -->
                            <Border Grid.Column="2" Background="{DynamicResource SemiColorBackground1}" CornerRadius="6" Padding="6">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                                    <StackPanel HorizontalAlignment="Left">
                                        <!-- Table Header Strip strictly matching screenshot -->
                                        <Border Background="{DynamicResource SemiColorBackground2}" CornerRadius="4" Padding="0,7" Margin="0,0,0,4">
                                            <StackPanel Orientation="Horizontal">
                                                <!-- 0. 行首状态字 (新/审/执/停 严格对照截图2/3) -->
                                                <Border Width="26" Padding="2,0"><TextBlock Text="设" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource SemiColorText2}" TextAlignment="Center"/></Border>
                                                <!-- 1. 选 -->
                                                <Border Width="34" Padding="4,0"><CheckBox Command="{Binding SelectAllOrdersCommand}" CommandParameter="True" HorizontalAlignment="Center"/></Border>
                                                <!-- 2. 医嘱类型 -->
                                                <Border Width="75" Padding="6,0"><TextBlock Text="医嘱类型" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource SemiColorText2}"/></Border>
                                                <!-- 3. 项目类别 -->
                                                <Border Width="75" Padding="6,0"><TextBlock Text="项目类别" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource SemiColorText2}"/></Border>
                                                <!-- 4. 加急 (严格对照截图2/3带复选框) -->
                                                <Border Width="50" Padding="2,0">
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="2">
                                                        <TextBlock Text="加急" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource SemiColorText2}" VerticalAlignment="Center"/>
                                                        <CheckBox Command="{Binding ToggleUrgentCommand}" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                                <!-- 5. 开立时间 -->
                                                <Border Width="120" Padding="6,0"><TextBlock Text="开立时间" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource SemiColorText2}"/></Border>
                                                <!-- 6. 项目 -->
                                                <Border Width="200" Padding="6,0"><TextBlock Text="项目" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource SemiColorText2}"/></Border>
                                                <!-- 7. 组 -->
                                                <Border Width="45" Padding="4,0"><TextBlock Text="组" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource SemiColorText2}" TextAlignment="Center"/></Border>
                                                <!-- 8. 规格 -->
                                                <Border Width="110" Padding="6,0"><TextBlock Text="规格" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource SemiColorText2}"/></Border>
                                                <!-- 9. 每次量 -->
                                                <Border Width="65" Padding="6,0"><TextBlock Text="每次量" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource SemiColorText2}" TextAlignment="Center"/></Border>
                                                <!-- 10. 单次基数 (严格对照截图2双行紧凑布局) -->
                                                <Border Width="60" Padding="2,0">
                                                    <StackPanel HorizontalAlignment="Center">
                                                        <TextBlock Text="单次" FontWeight="Bold" FontSize="10" Foreground="{DynamicResource SemiColorText2}" HorizontalAlignment="Center"/>
                                                        <TextBlock Text="基数" FontWeight="Bold" FontSize="10" Foreground="{DynamicResource SemiColorText2}" HorizontalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                                <!-- 12. 用量 -->
                                                <Border Width="55" Padding="6,0"><TextBlock Text="用量" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource SemiColorText2}" TextAlignment="Center"/></Border>
                                                <!-- 13. 单位 -->
                                                <Border Width="50" Padding="6,0"><TextBlock Text="单位" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource SemiColorText2}" TextAlignment="Center"/></Border>
                                                <!-- 14. 大数 -->
                                                <Border Width="50" Padding="6,0"><TextBlock Text="大数" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource SemiColorText2}" TextAlignment="Center"/></Border>
                                                <!-- 15. 数量 -->
                                                <Border Width="55" Padding="6,0"><TextBlock Text="数量" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource SemiColorText2}" TextAlignment="Center"/></Border>
                                                <!-- 16. 单位 -->
                                                <Border Width="50" Padding="6,0"><TextBlock Text="单位" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource SemiColorText2}" TextAlignment="Center"/></Border>
                                                <!-- 17. 付数 -->
                                                <Border Width="50" Padding="6,0"><TextBlock Text="付数" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource SemiColorText2}" TextAlignment="Center"/></Border>
                                                <!-- 18. 给药方法 -->
                                                <Border Width="85" Padding="6,0"><TextBlock Text="给药方法" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource SemiColorText2}"/></Border>
                                                <!-- 19. 滴速 -->
                                                <Border Width="75" Padding="6,0"><TextBlock Text="滴速" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource SemiColorText2}"/></Border>
                                                <!-- 20. 频次 -->
                                                <Border Width="85" Padding="6,0"><TextBlock Text="频次" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource SemiColorText2}"/></Border>
                                                <!-- 21. 院注次数 -->
                                                <Border Width="65" Padding="6,0"><TextBlock Text="院注次数" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource SemiColorText2}" TextAlignment="Center"/></Border>
                                                <!-- 22. 开立医生 -->
                                                <Border Width="75" Padding="6,0"><TextBlock Text="开立医生" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource SemiColorText2}"/></Border>
                                                <!-- 23. 执行科室 -->
                                                <Border Width="110" Padding="6,0"><TextBlock Text="执行科室" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource SemiColorText2}"/></Border>
                                                <!-- 24. 单价 -->
                                                <Border Width="65" Padding="6,0"><TextBlock Text="单价" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource SemiColorText2}"/></Border>
                                                <!-- 25. 总价 -->
                                                <Border Width="65" Padding="6,0"><TextBlock Text="总价" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource SemiColorText2}"/></Border>
                                                <!-- 26. 扣库科室 -->
                                                <Border Width="95" Padding="6,0"><TextBlock Text="扣库科室" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource SemiColorText2}"/></Border>
                                                <!-- 27. 备注 -->
                                                <Border Width="110" Padding="6,0"><TextBlock Text="备注" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource SemiColorText2}"/></Border>
                                                <!-- 28. 特殊属性 -->
                                                <Border Width="85" Padding="6,0"><TextBlock Text="特殊属性" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource SemiColorText2}"/></Border>
                                                <!-- 29. 开始时间 -->
                                                <Border Width="120" Padding="6,0"><TextBlock Text="开始时间" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource SemiColorText2}"/></Border>
                                                <!-- 30. 停止医生 -->
                                                <Border Width="75" Padding="6,0"><TextBlock Text="停止医生" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource SemiColorText2}"/></Border>
                                                <!-- 31. 停止原因 -->
                                                <Border Width="85" Padding="6,0"><TextBlock Text="停止原因" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource SemiColorText2}"/></Border>
                                                <!-- 32. 样本/份 (严格对照截图3双行紧凑布局) -->
                                                <Border Width="50" Padding="2,0">
                                                    <StackPanel HorizontalAlignment="Center">
                                                        <TextBlock Text="样本" FontWeight="Bold" FontSize="10" Foreground="{DynamicResource SemiColorText2}" HorizontalAlignment="Center"/>
                                                        <TextBlock Text="份" FontWeight="Bold" FontSize="10" Foreground="{DynamicResource SemiColorText2}" HorizontalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                                <!-- 33. 部位 -->
                                                <Border Width="60" Padding="6,0"><TextBlock Text="部位" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource SemiColorText2}"/></Border>
                                                <!-- 33. 检查方法 -->
                                                <Border Width="85" Padding="6,0"><TextBlock Text="检查方法" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource SemiColorText2}"/></Border>
                                                <!-- 34. 皮试信息 -->
                                                <Border Width="85" Padding="6,0"><TextBlock Text="皮试信息" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource SemiColorText2}"/></Border>
                                                <!-- 35. 停止时间 -->
                                                <Border Width="120" Padding="6,0"><TextBlock Text="停止时间" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource SemiColorText2}"/></Border>
                                                <!-- 36. 录入人 -->
                                                <Border Width="75" Padding="6,0"><TextBlock Text="录入人" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource SemiColorText2}"/></Border>
                                                <!-- 37. 开立科室 -->
                                                <Border Width="95" Padding="6,0"><TextBlock Text="开立科室" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource SemiColorText2}"/></Border>
                                                <!-- 38. 组合号 -->
                                                <Border Width="90" Padding="6,0"><TextBlock Text="组合号" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource SemiColorText2}"/></Border>
                                                <!-- 39. 顺序号 -->
                                                <Border Width="60" Padding="6,0"><TextBlock Text="顺序号" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource SemiColorText2}" TextAlignment="Center"/></Border>
                                                <!-- 40. 操作 -->
                                                <Border Width="100" Padding="6,0"><TextBlock Text="操作" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource SemiColorText2}" TextAlignment="Center"/></Border>
                                            </StackPanel>
                                        </Border>

                                        <!-- Table Rows -->
                                        <ItemsControl ItemsSource="{Binding Workbench.SelectedInpatient.FilteredOrders}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:InpatientOrderModel">
                                                    <Border Margin="0,2" CornerRadius="4"
                                                            Background="{DynamicResource SemiColorBackground0}"
                                                            BorderBrush="{DynamicResource SemiColorBorder}"
                                                            BorderThickness="1">
                                                        <StackPanel Orientation="Horizontal" MinHeight="36">
                                                            <!-- 0. 行首状态字 (新/审/执/停 严格对照截图2/3色彩) -->
                                                            <Border Width="26" Padding="2,0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding StatusLegendInitial}" Foreground="{Binding LegendBrush}" ToolTip.Tip="{Binding Status}" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center"/>
                                                            </Border>
                                                            <!-- 1. 选 -->
                                                            <Border Width="34" Padding="4,0" VerticalAlignment="Center">
                                                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" HorizontalAlignment="Center"/>
                                                            </Border>
                                                            <!-- 3. 医嘱类型 -->
                                                            <Border Width="75" Padding="6,0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding OrderType}" FontSize="12" Foreground="{Binding LegendBrush}" FontWeight="SemiBold"/>
                                                            </Border>
                                                            <!-- 4. 项目类别 -->
                                                            <Border Width="75" Padding="6,0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding ItemCategory}" FontSize="12" Foreground="{Binding LegendBrush}"/>
                                                            </Border>
                                                            <!-- 5. 加急 -->
                                                            <Border Width="50" Padding="6,0" VerticalAlignment="Center">
                                                                <CheckBox IsChecked="{Binding IsUrgent, Mode=TwoWay}" HorizontalAlignment="Center"/>
                                                            </Border>
                                                            <!-- 6. 开立时间 -->
                                                            <Border Width="120" Padding="6,0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding StartTime}" FontSize="11" Foreground="{Binding LegendBrush}"/>
                                                            </Border>
                                                            <!-- 7. 项目 (医嘱名称) -->
                                                            <Border Width="200" Padding="6,0" VerticalAlignment="Center">
                                                                <StackPanel Spacing="1">
                                                                    <TextBlock Text="{Binding Content}" FontWeight="Bold" FontSize="12" Foreground="{Binding LegendBrush}" TextTrimming="CharacterEllipsis"/>
                                                                    <TextBlock Text="{Binding Spec}" FontSize="10" Foreground="{DynamicResource SemiColorText2}" TextTrimming="CharacterEllipsis" IsVisible="{Binding Spec, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                                                </StackPanel>
                                                            </Border>
                                                            <!-- 8. 组 -->
                                                            <Border Width="45" Padding="4,0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding GroupDisplay}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource SemiColorPrimary}" HorizontalAlignment="Center"/>
                                                            </Border>
                                                            <!-- 9. 规格 -->
                                                            <Border Width="110" Padding="6,0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Spec}" FontSize="11" Foreground="{Binding LegendBrush}" TextTrimming="CharacterEllipsis"/>
                                                            </Border>
                                                            <!-- 10. 每次量 -->
                                                            <Border Width="65" Padding="6,0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding SingleDose}" FontSize="12" Foreground="{Binding LegendBrush}" HorizontalAlignment="Center"/>
                                                            </Border>
                                                            <!-- 11. 剂量单位 -->
                                                            <Border Width="65" Padding="6,0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding DoseUnit}" FontSize="12" Foreground="{Binding LegendBrush}" HorizontalAlignment="Center"/>
                                                            </Border>
                                                            <!-- 12. 用量 -->
                                                            <Border Width="55" Padding="6,0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding UsageAmount}" FontSize="12" Foreground="{Binding LegendBrush}" HorizontalAlignment="Center"/>
                                                            </Border>
                                                            <!-- 13. 单位 -->
                                                            <Border Width="50" Padding="6,0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding UsageUnit}" FontSize="12" Foreground="{Binding LegendBrush}" HorizontalAlignment="Center"/>
                                                            </Border>
                                                            <!-- 14. 大数 -->
                                                            <Border Width="50" Padding="6,0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding PackageQuantity}" FontSize="12" Foreground="{Binding LegendBrush}" HorizontalAlignment="Center"/>
                                                            </Border>
                                                            <!-- 15. 数量 -->
                                                            <Border Width="55" Padding="6,0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Quantity}" FontWeight="Bold" FontSize="12" Foreground="{Binding LegendBrush}" HorizontalAlignment="Center"/>
                                                            </Border>
                                                            <!-- 16. 单位 -->
                                                            <Border Width="50" Padding="6,0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Unit}" FontSize="12" Foreground="{Binding LegendBrush}" HorizontalAlignment="Center"/>
                                                            </Border>
                                                            <!-- 17. 付数 -->
                                                            <Border Width="50" Padding="6,0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding PrescriptionPacks}" FontSize="12" Foreground="{Binding LegendBrush}" HorizontalAlignment="Center"/>
                                                            </Border>
                                                            <!-- 18. 给药方法 -->
                                                            <Border Width="85" Padding="6,0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Route}" FontSize="12" Foreground="{Binding LegendBrush}" TextTrimming="CharacterEllipsis"/>
                                                            </Border>
                                                            <!-- 19. 滴速 -->
                                                            <Border Width="75" Padding="6,0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding DripRate}" FontSize="11" Foreground="{Binding LegendBrush}" TextTrimming="CharacterEllipsis"/>
                                                            </Border>
                                                            <!-- 20. 频次 -->
                                                            <Border Width="85" Padding="6,0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Frequency}" FontSize="12" Foreground="{Binding LegendBrush}" TextTrimming="CharacterEllipsis"/>
                                                            </Border>
                                                            <!-- 21. 院注次数 -->
                                                            <Border Width="65" Padding="6,0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding HospitalInjectionCount}" FontSize="12" Foreground="{Binding LegendBrush}" HorizontalAlignment="Center"/>
                                                            </Border>
                                                            <!-- 22. 开立医生 -->
                                                            <Border Width="75" Padding="6,0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding DoctorName}" FontSize="12" Foreground="{Binding LegendBrush}" TextTrimming="CharacterEllipsis"/>
                                                            </Border>
                                                            <!-- 23. 执行科室 -->
                                                            <Border Width="110" Padding="6,0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding ExecDept}" FontSize="11" Foreground="{Binding LegendBrush}" TextTrimming="CharacterEllipsis"/>
                                                            </Border>
                                                            <!-- 24. 单价 -->
                                                            <Border Width="65" Padding="6,0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding UnitPrice}" FontSize="11" Foreground="{Binding LegendBrush}"/>
                                                            </Border>
                                                            <!-- 25. 总价 -->
                                                            <Border Width="65" Padding="6,0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding TotalPrice}" FontWeight="SemiBold" FontSize="11" Foreground="{Binding LegendBrush}"/>
                                                            </Border>
                                                            <!-- 26. 扣库科室 -->
                                                            <Border Width="95" Padding="6,0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding DeductDept}" FontSize="11" Foreground="{Binding LegendBrush}" TextTrimming="CharacterEllipsis"/>
                                                            </Border>
                                                            <!-- 27. 备注 -->
                                                            <Border Width="110" Padding="6,0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Remark}" FontSize="11" Foreground="{Binding LegendBrush}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Remark}"/>
                                                            </Border>
                                                            <!-- 28. 特殊属性 -->
                                                            <Border Width="85" Padding="6,0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding SpecialAttr}" FontSize="11" Foreground="{Binding LegendBrush}" TextTrimming="CharacterEllipsis"/>
                                                            </Border>
                                                            <!-- 29. 开始时间 -->
                                                            <Border Width="120" Padding="6,0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding StartExecTime}" FontSize="11" Foreground="{Binding LegendBrush}"/>
                                                            </Border>
                                                            <!-- 30. 停止医生 -->
                                                            <Border Width="75" Padding="6,0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding StopDoctor}" FontSize="11" Foreground="{DynamicResource SemiColorText2}" TextTrimming="CharacterEllipsis"/>
                                                            </Border>
                                                            <!-- 31. 停止原因 -->
                                                            <Border Width="85" Padding="6,0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding StopReason}" FontSize="11" Foreground="{DynamicResource SemiColorText2}" TextTrimming="CharacterEllipsis"/>
                                                            </Border>
                                                            <!-- 32. 样本/份 -->
                                                            <Border Width="50" Padding="4,0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Specimen}" FontSize="11" Foreground="{Binding LegendBrush}" HorizontalAlignment="Center"/>
                                                            </Border>
                                                            <!-- 33. 部位 -->
                                                            <Border Width="60" Padding="6,0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding BodyPart}" FontSize="11" Foreground="{Binding LegendBrush}" TextTrimming="CharacterEllipsis"/>
                                                            </Border>
                                                            <!-- 33. 检查方法 -->
                                                            <Border Width="85" Padding="6,0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding ExamMethod}" FontSize="11" Foreground="{Binding LegendBrush}" TextTrimming="CharacterEllipsis"/>
                                                            </Border>
                                                            <!-- 34. 皮试信息 -->
                                                            <Border Width="85" Padding="6,0" VerticalAlignment="Center">
                                                                <Border Background="{DynamicResource SemiColorBackground2}" CornerRadius="3" Padding="4,1" HorizontalAlignment="Left">
                                                                    <TextBlock Text="{Binding SkinTestInfo}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding LegendBrush}"/>
                                                                </Border>
                                                            </Border>
                                                            <!-- 35. 停止时间 -->
                                                            <Border Width="120" Padding="6,0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding StopTime}" FontSize="11" Foreground="{DynamicResource SemiColorText3}"/>
                                                            </Border>
                                                            <!-- 36. 录入人 -->
                                                            <Border Width="75" Padding="6,0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding InputOperator}" FontSize="11" Foreground="{Binding LegendBrush}" TextTrimming="CharacterEllipsis"/>
                                                            </Border>
                                                            <!-- 37. 开立科室 -->
                                                            <Border Width="95" Padding="6,0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding OrderDept}" FontSize="11" Foreground="{Binding LegendBrush}" TextTrimming="CharacterEllipsis"/>
                                                            </Border>
                                                            <!-- 38. 组合号 -->
                                                            <Border Width="90" Padding="6,0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding GroupComboNo}" FontSize="11" Foreground="{DynamicResource SemiColorText2}"/>
                                                            </Border>
                                                            <!-- 39. 顺序号 -->
                                                            <Border Width="60" Padding="6,0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding SeqNo}" FontSize="12" Foreground="{Binding LegendBrush}" HorizontalAlignment="Center"/>
                                                            </Border>
                                                            <!-- 40. 操作 -->
                                                            <Border Width="100" Padding="6,0" VerticalAlignment="Center">
                                                                <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                                                                    <Button Content="停止" Height="24" Padding="6,0" Classes="Secondary" FontSize="11"
                                                                            IsVisible="{Binding CanStop}"
                                                                            Command="{Binding $parent[UserControl].((local:IpdDoctorViewModel)DataContext).StopOrderCommand}"
                                                                            CommandParameter="{Binding}"/>
                                                                    <Button Content="作废" Height="24" Padding="6,0" Classes="Danger" FontSize="11"
                                                                            IsVisible="{Binding CanCancel}"
                                                                            Command="{Binding $parent[UserControl].((local:IpdDoctorViewModel)DataContext).CancelOrderCommand}"
                                                                            CommandParameter="{Binding}"/>
                                                                </StackPanel>
                                                            </Border>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>
                        </Grid>

                        <!-- Bottom Tab Filter & Paging Bar strictly matching Screenshot 2 & 3 -->
                        <Border Grid.Row="3" Background="{DynamicResource SemiColorBackground1}" CornerRadius="4" Padding="8,4">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <!-- Paging Navigation and Order Tabs -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <Button Content="|&lt;&lt;" Classes="Tertiary" Height="24" Padding="6,0" FontSize="11"
                                            Command="{Binding GoFirstPageCommand}"/>
                                    <Button Content="&lt;" Classes="Tertiary" Height="24" Padding="6,0" FontSize="11"
                                            Command="{Binding GoPrevPageCommand}"/>
                                    <Button Content="&gt;" Classes="Tertiary" Height="24" Padding="6,0" FontSize="11"
                                            Command="{Binding GoNextPageCommand}"/>
                                    <Button Content="&gt;&gt;|" Classes="Tertiary" Height="24" Padding="6,0" FontSize="11"
                                            Command="{Binding GoLastPageCommand}"/>
                                    <u:Divider Margin="4,2"/>
                                    <Button Content="长 嘱" Classes="Secondary" Height="24" Padding="14,0" FontSize="12" FontWeight="Bold"
                                            Command="{Binding FilterOrdersCommand}" CommandParameter="LONG"/>
                                    <Button Content="临 嘱" Classes="Secondary" Height="24" Padding="14,0" FontSize="12" FontWeight="Bold"
                                            Command="{Binding FilterOrdersCommand}" CommandParameter="TEMP"/>
                                    <Button Content="全 部" Classes="Tertiary" Height="24" Padding="10,0" FontSize="12"
                                            Command="{Binding FilterOrdersCommand}" CommandParameter="ALL"/>
                                    <Button Content="待 审" Classes="Tertiary" Height="24" Padding="10,0" FontSize="12"
                                            Command="{Binding FilterOrdersCommand}" CommandParameter="PENDING"/>
                                </StackPanel>

                                <!-- Status / Parameter Text strictly matching Screenshot: 窗口参数 -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <Button Content="窗口参数" Classes="Tertiary" Height="24" Padding="8,0" FontSize="11"
                                            Command="{Binding OpenOrderSettingsCommand}"/>
                                    <u:Divider Margin="2,2"/>
                                    <TextBlock Text="{Binding Workbench.SelectedInpatient.ActiveOrderCount, StringFormat='{}有效 {0}'}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SemiColorPrimary}"/>
                                    <TextBlock Text="{Binding Workbench.SelectedInpatient.LongTermOrderCount, StringFormat='{}长期 {0}'}" FontSize="11" Foreground="{DynamicResource SemiColorText1}"/>
                                    <TextBlock Text="{Binding Workbench.SelectedInpatient.TempOrderCount, StringFormat='{}临时 {0}'}" FontSize="11" Foreground="{DynamicResource SemiColorText1}"/>
                                    <TextBlock Text="{Binding Workbench.SelectedInpatient.PendingOrderCount, StringFormat='{}待审 {0}'}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SemiColorWarning}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- Tab 1: 查房与病程 -->
                <TabItem Header="查房与病程">
                    <Grid RowDefinitions="Auto,*">
                        <Border Grid.Row="0" Background="{DynamicResource SemiColorBackground1}" CornerRadius="7"
                                BorderBrush="{DynamicResource SemiColorBorder}" BorderThickness="1" Padding="14" Margin="0,0,0,10">
                            <StackPanel Spacing="9">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0" Spacing="3">
                                        <TextBlock Text="今日查房摘要" FontSize="13" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding Workbench.SelectedInpatient.DailySummary}" FontSize="11"
                                                   Foreground="{DynamicResource SemiColorText2}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="{DynamicResource SemiColorBackground2}"
                                            CornerRadius="5" Padding="10,7" Margin="14,0,0,0">
                                        <StackPanel>
                                            <TextBlock Text="主管医师" FontSize="11" Foreground="{DynamicResource SemiColorText2}"/>
                                            <TextBlock Text="{Binding Workbench.SelectedInpatient.AttendingDoctor}" FontSize="11" FontWeight="Bold"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <u:Divider Margin="0,1"/>
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="新增病程记录 (Ctrl+S 保存)" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                        <ComboBox ItemsSource="{Binding UserTemplates}"
                                                  SelectedItem="{Binding SelectedUserTemplate, Mode=TwoWay}"
                                                  PlaceholderText="📋 选择常用病历模板调入..."
                                                  Width="240" Height="28" FontSize="11">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="vm:EmrUserTemplateModel">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <Border Background="{Binding ScopeBrush}" CornerRadius="3" Padding="4,1">
                                                            <TextBlock Text="{Binding ScopeBadgeText}" FontSize="9" Foreground="White" FontWeight="Bold"/>
                                                        </Border>
                                                        <TextBlock Text="{Binding TemplateName}" FontSize="11"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <Button Content="💾 存为常用模板" Height="28" Padding="10,0" FontSize="11"
                                                Command="{Binding SaveAsUserTemplateCommand}"/>
                                    </StackPanel>
                                </Grid>
                                <TextBox Text="{Binding Workbench.NewProgressNote, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap"
                                         PlaceholderText="记录患者症状、查体、检验结果及今日处理计划..."
                                         MinHeight="62"/>
                                <Grid ColumnDefinitions="*,Auto,Auto">
                                    <TextBlock Grid.Column="0" Text="提交后由主治医师完成终审签。"
                                               FontSize="11" Foreground="{DynamicResource SemiColorText2}" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Content="保存病程" Height="30" Padding="12,0"
                                            Margin="0,0,8,0" Command="{Binding AddProgressNoteCommand}"/>
                                    <Button Grid.Column="2" Content="审签最新病程" Classes="Primary" Height="30"
                                            Padding="12,0" Command="{Binding SignLatestProgressNoteCommand}"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1" Background="{DynamicResource SemiColorBackground1}" CornerRadius="7"
                                BorderBrush="{DynamicResource SemiColorBorder}" BorderThickness="1" Padding="14">
                            <Grid RowDefinitions="Auto,*">
                                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                                    <TextBlock Grid.Column="0" Text="病程记录" FontSize="13" FontWeight="Bold"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Workbench.SelectedInpatient.UnsignedNoteCount, StringFormat='{}{0} 份待审签'}"
                                               FontSize="11" Foreground="{DynamicResource SemiColorWarning}"/>
                                </Grid>
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl ItemsSource="{Binding Workbench.SelectedInpatient.ProgressNotes}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:ProgressNoteModel">
                                                <Border Padding="11" Margin="0,0,0,8" CornerRadius="6"
                                                        Background="{DynamicResource SemiColorBackground0}"
                                                        BorderBrush="{DynamicResource SemiColorBorder}" BorderThickness="1">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <StackPanel Grid.Column="0" Spacing="4">
                                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                                <TextBlock Text="{Binding RecordType}" FontWeight="Bold" FontSize="12"/>
                                                                <TextBlock Text="{Binding RecordTime}" FontSize="11" Foreground="{DynamicResource SemiColorText2}"/>
                                                                <TextBlock Text="{Binding Author}" FontSize="11" Foreground="{DynamicResource SemiColorText2}"/>
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding Content}" FontSize="11" TextWrapping="Wrap"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" Spacing="5" Margin="12,0,0,0">
                                                            <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="Bold"
                                                                       Foreground="{Binding StatusBrush}" HorizontalAlignment="Right"/>
                                                            <Button Content="审签" Height="25" Padding="8,0"
                                                                    IsVisible="{Binding !IsSigned}"
                                                                    Command="{Binding $parent[UserControl].((local:IpdDoctorViewModel)DataContext).SignNoteCommand}"
                                                                    CommandParameter="{Binding}"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- Tab 2: 审签与出院 -->
                <TabItem Header="审签与出院">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Spacing="10">
                            <Border Background="{DynamicResource SemiColorBackground1}" CornerRadius="7"
                                    BorderBrush="{DynamicResource SemiColorBorder}" BorderThickness="1" Padding="14">
                                <StackPanel Spacing="8">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0" Spacing="4">
                                            <TextBlock Text="出院六严关终审" FontSize="14" FontWeight="Bold"/>
                                            <TextBlock Text="医嘱闭环、医技归档、出院带药、病程审签、医保结算与预交金必须全部通过。"
                                                       FontSize="11" Foreground="{DynamicResource SemiColorText2}" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding Workbench.SelectedInpatient.DischargeGateSummary}" FontSize="12"
                                                       FontWeight="Bold" Foreground="{Binding Workbench.SelectedInpatient.DischargeGateBrush}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                            <Button Content="查看六严关详情 (F3)" Classes="Warning" Height="30" Padding="11,0"
                                                    Command="{Binding OpenDischargeCheckCommand}"/>
                                            <Button Content="提交出院申请" Classes="Primary" Height="30" Padding="11,0"
                                                    Command="{Binding ApproveDischargeCommand}"/>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="{Binding DischargeBlockedReason}" FontSize="11" Foreground="{DynamicResource SemiColorWarning}"
                                               TextWrapping="Wrap"
                                               IsVisible="{Binding DischargeBlockedReason, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                </StackPanel>
                            </Border>

                            <Border Background="{DynamicResource SemiColorBackground1}" CornerRadius="7"
                                    BorderBrush="{DynamicResource SemiColorBorder}" BorderThickness="1" Padding="14">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="六严关状态" FontSize="13" FontWeight="Bold"/>
                                    <Border Background="{DynamicResource SemiColorBackground0}" CornerRadius="5" Padding="10,8">
                                        <Grid ColumnDefinitions="180,*">
                                            <TextBlock Grid.Column="0" Text="1  医嘱闭环" FontSize="11" FontWeight="SemiBold"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Workbench.DischargeCheckDetails.OrdersGateText}"
                                                       FontSize="11" Foreground="{Binding Workbench.DischargeCheckDetails.OrdersGateBrush}"/>
                                        </Grid>
                                    </Border>
                                    <Border Background="{DynamicResource SemiColorBackground0}" CornerRadius="5" Padding="10,8">
                                        <Grid ColumnDefinitions="180,*">
                                            <TextBlock Grid.Column="0" Text="2  医技报告归档" FontSize="11" FontWeight="SemiBold"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Workbench.DischargeCheckDetails.MedTechGateText}"
                                                       FontSize="11" Foreground="{Binding Workbench.DischargeCheckDetails.MedTechGateBrush}"/>
                                        </Grid>
                                    </Border>
                                    <Border Background="{DynamicResource SemiColorBackground0}" CornerRadius="5" Padding="10,8">
                                        <Grid ColumnDefinitions="180,*">
                                            <TextBlock Grid.Column="0" Text="3  出院带药配发" FontSize="11" FontWeight="SemiBold"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Workbench.DischargeCheckDetails.MedsGateText}"
                                                       FontSize="11" Foreground="{Binding Workbench.DischargeCheckDetails.MedsGateBrush}"/>
                                        </Grid>
                                    </Border>
                                    <Border Background="{DynamicResource SemiColorBackground0}" CornerRadius="5" Padding="10,8">
                                        <Grid ColumnDefinitions="180,*">
                                            <TextBlock Grid.Column="0" Text="4  病程全部审签" FontSize="11" FontWeight="SemiBold"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Workbench.DischargeCheckDetails.EmrGateText}"
                                                       FontSize="11" Foreground="{Binding Workbench.DischargeCheckDetails.EmrGateBrush}"/>
                                        </Grid>
                                    </Border>
                                    <Border Background="{DynamicResource SemiColorBackground0}" CornerRadius="5" Padding="10,8">
                                        <Grid ColumnDefinitions="180,*">
                                            <TextBlock Grid.Column="0" Text="5  医保结算核验" FontSize="11" FontWeight="SemiBold"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Workbench.DischargeCheckDetails.InsuranceGateText}"
                                                       FontSize="11" Foreground="{Binding Workbench.DischargeCheckDetails.InsuranceGateBrush}"/>
                                        </Grid>
                                    </Border>
                                    <Border Background="{DynamicResource SemiColorBackground0}" CornerRadius="5" Padding="10,8">
                                        <Grid ColumnDefinitions="180,*">
                                            <TextBlock Grid.Column="0" Text="6  预交金结清" FontSize="11" FontWeight="SemiBold"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Workbench.DischargeCheckDetails.PrepaymentGateText}"
                                                       FontSize="11" Foreground="{Binding Workbench.DischargeCheckDetails.PrepaymentGateBrush}"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <Border Background="{DynamicResource SemiColorBackground1}" CornerRadius="7"
                                    BorderBrush="{DynamicResource SemiColorBorder}" BorderThickness="1" Padding="14">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="住院流程闭环" FontSize="13" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding Workbench.SelectedInpatient.WorkflowCounts}" FontSize="11"
                                               Foreground="{DynamicResource SemiColorText2}"/>
                                    <TextBlock Text="出院终审只在六严关全部通过后开放。未通过时按钮保持锁定，避免漏费与带药差错。"
                                               FontSize="11" Foreground="{DynamicResource SemiColorText2}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            
            <TabItem Header="专科动态表单(BO)">
                <ScrollViewer Padding="10">
                    <controls:BoDynamicFormPanel EntityType="IPD_ENCOUNTER"
                                                 EntityId="{Binding Workbench.SelectedInpatient.AdmissionNo}"/>
                </ScrollViewer>
            </TabItem>
        </TabControl>
        </Grid>
    </Grid>
</UserControl>
