<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:HIS.Client.UrsaShell.Stations.Admin"
             xmlns:vm="using:HIS.Client.UrsaShell.ViewModels"
             xmlns:controls="using:HIS.Client.UrsaShell.Shell.Controls"
             x:Class="HIS.Client.UrsaShell.Stations.Admin.AuditLogStationView"
             x:DataType="local:AuditLogStationViewModel">
    <Grid RowDefinitions="Auto,Auto,*" Margin="16" RowSpacing="12">
        <!-- 顶部安全态势与密评等保合规指标看板 (design-taste-frontend 四维等距卡片) -->
        <Grid Grid.Row="0" ColumnDefinitions="*,*,*,*" ColumnSpacing="12">
            <!-- 卡片 1: 等保三级安全态势分 -->
            <Border Grid.Column="0" Padding="14,12" CornerRadius="8"
                    Background="{DynamicResource SemiColorBackground1}"
                    BorderBrush="{DynamicResource SemiColorBorder}" BorderThickness="1">
                <StackPanel Spacing="6">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="等保三级安全态势" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SemiColorText2}"/>
                        <controls:StatusTag Grid.Column="1" Text="{Binding Workbench.ThreatLevel}" Kind="{Binding Workbench.ThreatLevelBadgeClass}"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Workbench.SecurityScore}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource SemiColorPrimary}"/>
                        <TextBlock Text="/ 100 分" FontSize="13" Foreground="{DynamicResource SemiColorText2}" VerticalAlignment="Bottom" Margin="0,0,0,3"/>
                    </StackPanel>
                    <TextBlock Text="{Binding Workbench.DengbaoStatus}" FontSize="11" Foreground="{DynamicResource SemiColorText2}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>

            <!-- 卡片 2: 密评三级密码合规 -->
            <Border Grid.Column="1" Padding="14,12" CornerRadius="8"
                    Background="{DynamicResource SemiColorBackground1}"
                    BorderBrush="{DynamicResource SemiColorBorder}" BorderThickness="1">
                <StackPanel Spacing="6">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="密评三级合规基线" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SemiColorText2}"/>
                        <controls:StatusTag Grid.Column="1" Text="国密合规" Kind="Success"/>
                    </Grid>
                    <TextBlock Text="SM2 / SM3 / SM4" FontSize="18" FontWeight="Bold" Margin="0,2,0,0"/>
                    <TextBlock Text="{Binding Workbench.NationalCipherStatus}" FontSize="11" Foreground="{DynamicResource SemiColorText2}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>

            <!-- 卡片 3: HSM 硬件密码机状态 -->
            <Border Grid.Column="2" Padding="14,12" CornerRadius="8"
                    Background="{DynamicResource SemiColorBackground1}"
                    BorderBrush="{DynamicResource SemiColorBorder}" BorderThickness="1">
                <StackPanel Spacing="6">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="HSM 硬件密码机" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SemiColorText2}"/>
                        <controls:StatusTag Grid.Column="1" Text="硬件隔离" Kind="Success"/>
                    </Grid>
                    <TextBlock Text="{Binding Workbench.HsmStatus}" FontSize="16" FontWeight="Bold" Margin="0,4,0,0"/>
                    <TextBlock Text="PCI-E Level 3 物理防探测 / 硬件零化保护" FontSize="11" Foreground="{DynamicResource SemiColorText2}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>

            <!-- 卡片 4: 哈希防篡改存证与活跃威胁 -->
            <Border Grid.Column="3" Padding="14,12" CornerRadius="8"
                    Background="{DynamicResource SemiColorBackground1}"
                    BorderBrush="{DynamicResource SemiColorBorder}" BorderThickness="1">
                <StackPanel Spacing="6">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="活跃威胁与审计链" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SemiColorText2}"/>
                        <controls:StatusTag Grid.Column="1" Text="{Binding Workbench.AuditVerificationBadgeClass}" Kind="{Binding Workbench.AuditVerificationBadgeClass}"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding Workbench.ActiveAlertsCount, StringFormat='未处置告警: {0}'}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource SemiColorDanger}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding Workbench.AuditVerificationStatus}" FontSize="11" Foreground="{DynamicResource SemiColorText2}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 次级导航条与多维操作区 -->
        <Border Grid.Row="1" Padding="10,8" CornerRadius="8"
                Background="{DynamicResource SemiColorBackground1}"
                BorderBrush="{DynamicResource SemiColorBorder}" BorderThickness="1">
            <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                <!-- 切换面板按钮组 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
                    <Button Content="等保审计存证链" Classes="Tertiary" Height="30"
                            Command="{Binding SwitchSubTabCommand}" CommandParameter="0"/>
                    <Button Content="集中入侵防范与告警" Classes="Tertiary" Height="30"
                            Command="{Binding SwitchSubTabCommand}" CommandParameter="1"/>
                    <Button Content="KMS 密钥全生命周期" Classes="Tertiary" Height="30"
                            Command="{Binding SwitchSubTabCommand}" CommandParameter="2"/>
                    <Button Content="病历读审计与SM3链 (09.03)" Classes="Tertiary" Height="30"
                            Command="{Binding SwitchSubTabCommand}" CommandParameter="3"/>
                    <Button Content="过程级电子签名验真 (09.02)" Classes="Tertiary" Height="30"
                            Command="{Binding SwitchSubTabCommand}" CommandParameter="4"/>
                    <Button Content="限时细粒度访问授权" Classes="Tertiary" Height="30"
                            Command="{Binding SwitchSubTabCommand}" CommandParameter="5"/>
                </StackPanel>

                <!-- 当前标签快捷操作 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                    <Button Content="刷新全部 (F5)" Classes="Tertiary" Height="30" Command="{Binding QueryLogsCommand}"/>
                    <Button Content="全网威胁扫描" Classes="Warning" Height="30" Command="{Binding ScanThreatsCommand}"/>
                    <Button Content="固化防截断锚点 (F3)" Classes="Tertiary" Height="30" Command="{Binding CreateAnchorCommand}"/>
                    <Button Content="校验哈希链完整性 (F2)" Classes="Primary" Height="30" Command="{Binding VerifyChainCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 内容区域：根据 SelectedSubTabIndex 切换三个面板 -->
        <Grid Grid.Row="2">
            <!-- ============================================== -->
            <!-- 面板 0: 安全审计流水与防篡改存证链 -->
            <!-- ============================================== -->
            <Grid RowDefinitions="Auto,*" RowSpacing="8" IsVisible="{Binding SelectedSubTabIndex, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=0}">
                <!-- 三维检索过滤条 -->
                <Grid Grid.Row="0" ColumnDefinitions="*,*,*,Auto,Auto" ColumnSpacing="8">
                    <TextBox x:Name="EventFilterBox" Grid.Column="0"
                             Text="{Binding Workbench.AuditEventTypeFilter, Mode=TwoWay}"
                             PlaceholderText="事件类型过滤（如 PRICE_ADJUST / LOGIN / EMR_SIGN）(Ctrl+F)"/>
                    <TextBox Grid.Column="1"
                             Text="{Binding Workbench.AuditTargetEntityFilter, Mode=TwoWay}"
                             PlaceholderText="目标实体过滤（如 pat_patients / opd_prescriptions）"/>
                    <TextBox Grid.Column="2"
                             Text="{Binding Workbench.AuditOperatorFilter, Mode=TwoWay}"
                             PlaceholderText="操作人姓名或工号过滤"/>
                    <Button Grid.Column="3" Content="执行检索" Classes="Primary" Height="32" Command="{Binding QueryLogsCommand}"/>
                    <Button Grid.Column="4" Content="清空" Height="32" Command="{Binding ClearFilterCommand}"/>
                </Grid>

                <!-- 审计流水表 -->
                <Border Grid.Row="1" CornerRadius="8" Padding="12"
                        Background="{DynamicResource SemiColorBackground1}"
                        BorderBrush="{DynamicResource SemiColorBorder}" BorderThickness="1">
                    <Grid RowDefinitions="Auto,*">
                        <Grid Grid.Row="0" ColumnDefinitions="150,150,130,170,*,160,90" Margin="8,4,8,8">
                            <TextBlock Grid.Column="0" Text="时间" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SemiColorText2}"/>
                            <TextBlock Grid.Column="1" Text="事件类型" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SemiColorText2}"/>
                            <TextBlock Grid.Column="2" Text="操作人" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SemiColorText2}"/>
                            <TextBlock Grid.Column="3" Text="目标实体" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SemiColorText2}"/>
                            <TextBlock Grid.Column="4" Text="操作详情" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SemiColorText2}"/>
                            <TextBlock Grid.Column="5" Text="链哈希摘要" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SemiColorText2}"/>
                            <TextBlock Grid.Column="6" Text="存证" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SemiColorText2}"/>
                        </Grid>

                        <ScrollViewer Grid.Row="1">
                            <ItemsControl ItemsSource="{Binding Workbench.AuditLogsList}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:AuditLogEntryModel">
                                        <Border Margin="0,3" Padding="10" CornerRadius="6"
                                                Background="{DynamicResource SemiColorBackground0}"
                                                BorderBrush="{DynamicResource SemiColorBorder}" BorderThickness="1">
                                            <Grid ColumnDefinitions="150,150,130,170,*,160,90">
                                                <TextBlock Grid.Column="0" Text="{Binding FormattedTime}" FontSize="12" VerticalAlignment="Center"/>
                                                <controls:StatusTag Grid.Column="1" Text="{Binding EventType}" Kind="{Binding EventBadgeClass}" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding OperatorName}" FontWeight="SemiBold" FontSize="12"/>
                                                    <TextBlock Text="{Binding UserId}" FontSize="11" Foreground="{DynamicResource SemiColorText2}"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding TargetEntity}" FontSize="12"/>
                                                    <TextBlock Text="{Binding TargetId}" FontSize="11" Foreground="{DynamicResource SemiColorText2}" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="4" Text="{Binding ActionDetail}" FontSize="12" TextWrapping="Wrap" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="5" Text="{Binding ShortHash}" FontFamily="Consolas" FontSize="12" Foreground="{DynamicResource SemiColorText2}" VerticalAlignment="Center"/>
                                                <Button Grid.Column="6" Content="详情" Classes="Primary" Height="28" FontSize="12" VerticalAlignment="Center"
                                                        Command="{Binding $parent[UserControl].((local:AuditLogStationViewModel)DataContext).InspectEntryCommand}"
                                                        CommandParameter="{Binding}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <!-- ============================================== -->
            <!-- 面板 1: 集中入侵防范与安全告警 (M-019) -->
            <!-- ============================================== -->
            <Border Grid.Row="0" CornerRadius="8" Padding="14"
                    Background="{DynamicResource SemiColorBackground1}"
                    BorderBrush="{DynamicResource SemiColorBorder}" BorderThickness="1"
                    IsVisible="{Binding SelectedSubTabIndex, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=1}">
                <Grid RowDefinitions="Auto,*">
                    <Grid Grid.Row="0" ColumnDefinitions="140,160,110,140,*,110,100" Margin="8,0,8,10">
                        <TextBlock Grid.Column="0" Text="告警编号" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SemiColorText2}"/>
                        <TextBlock Grid.Column="1" Text="威胁类型" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SemiColorText2}"/>
                        <TextBlock Grid.Column="2" Text="风险等级" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SemiColorText2}"/>
                        <TextBlock Grid.Column="3" Text="受害账号 / 来源IP" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SemiColorText2}"/>
                        <TextBlock Grid.Column="4" Text="威胁与异常行为描述" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SemiColorText2}"/>
                        <TextBlock Grid.Column="5" Text="状态" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SemiColorText2}"/>
                        <TextBlock Grid.Column="6" Text="操作" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SemiColorText2}"/>
                    </Grid>

                    <ScrollViewer Grid.Row="1">
                        <ItemsControl ItemsSource="{Binding Workbench.SecurityAlertsList}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:SecurityAlertModel">
                                    <Border Margin="0,3" Padding="12,10" CornerRadius="6"
                                            Background="{DynamicResource SemiColorBackground0}"
                                            BorderBrush="{DynamicResource SemiColorBorder}" BorderThickness="1">
                                        <Grid ColumnDefinitions="140,160,110,140,*,110,100">
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding AlertNo}" FontWeight="SemiBold" FontSize="12"/>
                                                <TextBlock Text="{Binding FormattedTime}" FontSize="11" Foreground="{DynamicResource SemiColorText2}"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding AlertType}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                                            <controls:StatusTag Grid.Column="2" Text="{Binding Severity}" Kind="{Binding SeverityBadgeClass}" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                            <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding UserId}" FontSize="12" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding SourceIp}" FontSize="11" Foreground="{DynamicResource SemiColorText2}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="4" VerticalAlignment="Center" Margin="0,0,12,0">
                                                <TextBlock Text="{Binding Description}" FontSize="12" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding ResolutionNote, StringFormat='处置说明: {0}'}" FontSize="11" Foreground="{DynamicResource SemiColorSuccess}"
                                                           IsVisible="{Binding !IsActive}"/>
                                            </StackPanel>
                                            <controls:StatusTag Grid.Column="5" Text="{Binding Status}" Kind="{Binding StatusBadgeClass}" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                            <Button Grid.Column="6" Content="处置闭环" Classes="Primary" Height="28" FontSize="12" VerticalAlignment="Center"
                                                    IsEnabled="{Binding IsActive}"
                                                    Command="{Binding $parent[UserControl].((local:AuditLogStationViewModel)DataContext).ResolveAlertCommand}"
                                                    CommandParameter="{Binding}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- ============================================== -->
            <!-- 面板 2: KMS / HSM 密钥全生命周期管理 (M-021) -->
            <!-- ============================================== -->
            <Border Grid.Row="0" CornerRadius="8" Padding="14"
                    Background="{DynamicResource SemiColorBackground1}"
                    BorderBrush="{DynamicResource SemiColorBorder}" BorderThickness="1"
                    IsVisible="{Binding SelectedSubTabIndex, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=2}">
                <Grid RowDefinitions="Auto,*">
                    <Grid Grid.Row="0" ColumnDefinitions="160,100,70,100,200,*,120,110" Margin="8,0,8,10">
                        <TextBlock Grid.Column="0" Text="主密钥名称 (KeyName)" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SemiColorText2}"/>
                        <TextBlock Grid.Column="1" Text="加密算法" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SemiColorText2}"/>
                        <TextBlock Grid.Column="2" Text="版本" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SemiColorText2}"/>
                        <TextBlock Grid.Column="3" Text="生命周期" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SemiColorText2}"/>
                        <TextBlock Grid.Column="4" Text="硬件指纹 (SM3 Entropy)" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SemiColorText2}"/>
                        <TextBlock Grid.Column="5" Text="密钥用途说明" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SemiColorText2}"/>
                        <TextBlock Grid.Column="6" Text="有效期截止" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SemiColorText2}"/>
                        <TextBlock Grid.Column="7" Text="平滑轮换" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SemiColorText2}"/>
                    </Grid>

                    <ScrollViewer Grid.Row="1">
                        <ItemsControl ItemsSource="{Binding Workbench.KmsKeysList}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:KmsKeyModel">
                                    <Border Margin="0,4" Padding="12,12" CornerRadius="6"
                                            Background="{DynamicResource SemiColorBackground0}"
                                            BorderBrush="{DynamicResource SemiColorBorder}" BorderThickness="1">
                                        <Grid ColumnDefinitions="160,100,70,100,200,*,120,110">
                                            <TextBlock Grid.Column="0" Text="{Binding KeyName}" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Algorithm}" FontSize="12" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Version, StringFormat='v{0}'}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <controls:StatusTag Grid.Column="3" Text="{Binding State}" Kind="{Binding StateBadgeClass}" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                            <TextBlock Grid.Column="4" Text="{Binding KeyFingerprint}" FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource SemiColorText2}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="5" Text="{Binding Description}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" TextWrapping="Wrap"/>
                                            <TextBlock Grid.Column="6" Text="{Binding FormattedExpiry}" FontSize="12" Foreground="{DynamicResource SemiColorText2}" VerticalAlignment="Center"/>
                                            <Button Grid.Column="7" Content="立即轮换" Classes="Warning" Height="28" FontSize="12" VerticalAlignment="Center"
                                                    IsEnabled="{Binding IsActive}"
                                                    Command="{Binding $parent[UserControl].((local:AuditLogStationViewModel)DataContext).RotateKeyCommand}"
                                                    CommandParameter="{Binding}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- ============================================== -->
            <!-- 面板 3: 病历全量读审计与SM3链式验真 (09.03) -->
            <!-- ============================================== -->
            <Border Grid.Row="0" CornerRadius="8" Padding="14"
                    Background="{DynamicResource SemiColorBackground1}"
                    BorderBrush="{DynamicResource SemiColorBorder}" BorderThickness="1"
                    IsVisible="{Binding SelectedSubTabIndex, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=3}">
                <Grid RowDefinitions="Auto,Auto,*">
                    <Grid Grid.Row="0" ColumnDefinitions="Auto,140,Auto,140,Auto,*,Auto" ColumnSpacing="8" Margin="0,0,0,10">
                        <TextBlock Text="患者编号:" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"/>
                        <TextBox Grid.Column="1" Text="{Binding ReadAuditPatientIdFilter, Mode=TwoWay}" Height="30" FontSize="12"/>
                        <TextBlock Grid.Column="2" Text="访问人工号:" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"/>
                        <TextBox Grid.Column="3" Text="{Binding ReadAuditUserIdFilter, Mode=TwoWay}" Height="30" FontSize="12"/>
                        <Button Grid.Column="4" Content="查询读审计流水" Classes="Primary" Height="30" Command="{Binding QueryReadAuditsCommand}"/>
                        <Button Grid.Column="6" Content="🔗 校验SM3读审计链完整性" Classes="Warning" Height="30" Command="{Binding VerifyReadAuditChainCommand}"/>
                    </Grid>

                    <Border Grid.Row="1" Background="{DynamicResource SemiColorBackground0}" CornerRadius="6" Padding="10,6" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="审计链完整性状态:" FontWeight="SemiBold" VerticalAlignment="Center" FontSize="12"/>
                            <TextBlock Text="{Binding ReadAuditChainStatus}" FontWeight="Bold" Foreground="{DynamicResource SemiColorPrimary}" VerticalAlignment="Center" FontSize="12"/>
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="2" RowDefinitions="Auto,*">
                        <Grid Grid.Row="0" ColumnDefinitions="140,110,80,100,120,80,90,*,*" Margin="8,0,8,8">
                            <TextBlock Grid.Column="0" Text="查阅时间" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SemiColorText2}"/>
                            <TextBlock Grid.Column="1" Text="访问人" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SemiColorText2}"/>
                            <TextBlock Grid.Column="2" Text="类型" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SemiColorText2}"/>
                            <TextBlock Grid.Column="3" Text="患者" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SemiColorText2}"/>
                            <TextBlock Grid.Column="4" Text="资源类型" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SemiColorText2}"/>
                            <TextBlock Grid.Column="5" Text="操作" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SemiColorText2}"/>
                            <TextBlock Grid.Column="6" Text="判定决策" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SemiColorText2}"/>
                            <TextBlock Grid.Column="7" Text="前序哈希 (Prev SM3)" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SemiColorText2}"/>
                            <TextBlock Grid.Column="8" Text="当前记录哈希 (Curr SM3)" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SemiColorText2}"/>
                        </Grid>

                        <ScrollViewer Grid.Row="1">
                            <ItemsControl ItemsSource="{Binding ReadAudits}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="local:EmrReadAuditItemModel">
                                        <Border Margin="0,2" Padding="8,8" Background="{DynamicResource SemiColorBackground0}" CornerRadius="4">
                                            <Grid ColumnDefinitions="140,110,80,100,120,80,90,*,*">
                                                <TextBlock Grid.Column="0" Text="{Binding TimeText}" FontSize="11" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding AccessUserName}" FontWeight="Bold" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Text="{Binding IsExternal, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=true, StringFormat='{}外院'}"
                                                           Foreground="{DynamicResource SemiColorWarning}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="3" Text="{Binding PatientId}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="4" Text="{Binding ResourceType}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="5" Text="{Binding ActionType}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="6" Text="{Binding Decision}" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource SemiColorSuccess}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="7" Text="{Binding PrevHash}" FontFamily="Consolas" FontSize="10" Foreground="{DynamicResource SemiColorText2}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="8" Text="{Binding CurrHash}" FontFamily="Consolas" FontSize="10" Foreground="{DynamicResource SemiColorPrimary}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>

            <!-- ============================================== -->
            <!-- 面板 4: 临床过程数字签名与RFC 3161时间戳验真 (09.02) -->
            <!-- ============================================== -->
            <Border Grid.Row="0" CornerRadius="8" Padding="14"
                    Background="{DynamicResource SemiColorBackground1}"
                    BorderBrush="{DynamicResource SemiColorBorder}" BorderThickness="1"
                    IsVisible="{Binding SelectedSubTabIndex, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=4}">
                <Grid RowDefinitions="Auto,Auto,*">
                    <Grid Grid.Row="0" ColumnDefinitions="Auto,140,Auto,200,Auto,*" ColumnSpacing="8" Margin="0,0,0,12">
                        <TextBlock Text="实体类型:" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"/>
                        <ComboBox Grid.Column="1" SelectedItem="{Binding SigEntityType, Mode=TwoWay}" Height="30" FontSize="12">
                            <x:String>EMR_DOC</x:String>
                            <x:String>ORDER</x:String>
                            <x:String>PRESCRIPTION</x:String>
                            <x:String>MEDTECH_REQUEST</x:String>
                            <x:String>BLOOD_APPLY</x:String>
                            <x:String>SURGERY_RECORD</x:String>
                        </ComboBox>
                        <TextBlock Grid.Column="2" Text="实体编号 (ID):" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"/>
                        <TextBox Grid.Column="3" Text="{Binding SigEntityId, Mode=TwoWay}" Height="30" FontSize="12" PlaceholderText="如 DOC-xxx / ORD-xxx"/>
                        <Button Grid.Column="4" Content="检索数字签名" Classes="Primary" Height="30" Command="{Binding QuerySignaturesCommand}"/>
                    </Grid>

                    <Grid Grid.Row="1" ColumnDefinitions="140,100,100,100,140,*,120" Margin="8,0,8,8">
                        <TextBlock Grid.Column="0" Text="签署时间" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SemiColorText2}"/>
                        <TextBlock Grid.Column="1" Text="签署医师" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SemiColorText2}"/>
                        <TextBlock Grid.Column="2" Text="角色" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SemiColorText2}"/>
                        <TextBlock Grid.Column="3" Text="国密算法" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SemiColorText2}"/>
                        <TextBlock Grid.Column="4" Text="证书指纹" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SemiColorText2}"/>
                        <TextBlock Grid.Column="5" Text="第三方时间戳 Token (RFC 3161)" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SemiColorText2}"/>
                        <TextBlock Grid.Column="6" Text="验真操作" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SemiColorText2}"/>
                    </Grid>

                    <ScrollViewer Grid.Row="2">
                        <ItemsControl ItemsSource="{Binding DigitalSignatures}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:DigitalSignatureItemModel">
                                    <Border Margin="0,3" Padding="8,8" Background="{DynamicResource SemiColorBackground0}" CornerRadius="4">
                                        <Grid ColumnDefinitions="140,100,100,100,140,*,120">
                                            <TextBlock Grid.Column="0" Text="{Binding TimeText}" FontSize="11" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding SignerName}" FontWeight="Bold" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{Binding SignerRole}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="3" Text="{Binding SignatureAlgorithm}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="4" Text="{Binding CertFingerprint}" FontFamily="Consolas" FontSize="10" Foreground="{DynamicResource SemiColorText2}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="5" VerticalAlignment="Center" Margin="0,0,10,0">
                                                <TextBlock Text="{Binding TimestampToken}" FontFamily="Consolas" FontSize="10" Foreground="{DynamicResource SemiColorText2}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding VerifyMessage}" FontSize="11" Foreground="{DynamicResource SemiColorSuccess}" IsVisible="{Binding IsVerified, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                                            </StackPanel>
                                            <Button Grid.Column="6" Content="🔍 验签与TSA验真" Classes="Secondary" Height="28" FontSize="11"
                                                    Command="{Binding $parent[UserControl].((local:AuditLogStationViewModel)DataContext).VerifySignatureCommand}"
                                                    CommandParameter="{Binding}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- ============================================== -->
            <!-- 面板 5: 细粒度病历限时访问授权与外院换票 (09.03) -->
            <!-- ============================================== -->
            <Border Grid.Row="0" CornerRadius="8" Padding="14"
                    Background="{DynamicResource SemiColorBackground1}"
                    BorderBrush="{DynamicResource SemiColorBorder}" BorderThickness="1"
                    IsVisible="{Binding SelectedSubTabIndex, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=5}">
                <Grid ColumnDefinitions="*,400" ColumnSpacing="14">
                    <!-- 左侧：授权记录一览 -->
                    <Grid Grid.Column="0" RowDefinitions="Auto,Auto,*">
                        <Grid Grid.Row="0" ColumnDefinitions="Auto,120,Auto,120,Auto,*" ColumnSpacing="8" Margin="0,0,0,10">
                            <TextBlock Text="患者编号:" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"/>
                            <TextBox Grid.Column="1" Text="{Binding GrantPatientId, Mode=TwoWay}" Height="30" FontSize="12"/>
                            <TextBlock Grid.Column="2" Text="授权医师:" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"/>
                            <TextBox Grid.Column="3" Text="{Binding GranteeUserId, Mode=TwoWay}" Height="30" FontSize="12"/>
                            <Button Grid.Column="4" Content="查询授权" Classes="Primary" Height="30" Command="{Binding QueryAccessGrantsCommand}"/>
                        </Grid>

                        <Grid Grid.Row="1" ColumnDefinitions="100,100,80,140,*,80,80" Margin="8,0,8,8">
                            <TextBlock Grid.Column="0" Text="患者编号" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SemiColorText2}"/>
                            <TextBlock Grid.Column="1" Text="被授权人" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SemiColorText2}"/>
                            <TextBlock Grid.Column="2" Text="授权类型" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SemiColorText2}"/>
                            <TextBlock Grid.Column="3" Text="有效期起止" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SemiColorText2}"/>
                            <TextBlock Grid.Column="4" Text="授权事由" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SemiColorText2}"/>
                            <TextBlock Grid.Column="5" Text="状态" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SemiColorText2}"/>
                            <TextBlock Grid.Column="6" Text="操作" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SemiColorText2}"/>
                        </Grid>

                        <ScrollViewer Grid.Row="2">
                            <ItemsControl ItemsSource="{Binding AccessGrants}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="local:EmrAccessGrantItemModel">
                                        <Border Margin="0,3" Padding="8,8" Background="{DynamicResource SemiColorBackground0}" CornerRadius="4">
                                            <Grid ColumnDefinitions="100,100,80,140,*,80,80">
                                                <TextBlock Grid.Column="0" Text="{Binding PatientId}" FontWeight="Bold" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding GranteeUserId}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Text="{Binding IsExternalGrant, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=true, StringFormat='{}外院授权'}"
                                                           Foreground="{DynamicResource SemiColorWarning}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="3" Text="{Binding ValidRangeText}" FontSize="11" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="4" Text="{Binding GrantReason}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="5" Text="{Binding StatusText}" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource SemiColorSuccess}" VerticalAlignment="Center"/>
                                                <Button Grid.Column="6" Content="立即回收" Classes="Danger" Height="26" FontSize="11"
                                                        Command="{Binding $parent[UserControl].((local:AuditLogStationViewModel)DataContext).RevokeAccessGrantCommand}"
                                                        CommandParameter="{Binding}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                    <!-- 右侧：颁发限时细粒度授权 -->
                    <Border Grid.Column="1" CornerRadius="8" Padding="14"
                            Background="{DynamicResource SemiColorBackground0}"
                            BorderBrush="{DynamicResource SemiColorBorder}" BorderThickness="1">
                        <ScrollViewer>
                            <StackPanel Spacing="10">
                                <TextBlock Text="颁发病历细粒度限时访问凭证" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource SemiColorPrimary}"/>
                                <TextBlock Text="支持跨机构外院经授权医师限时换票访问，严格绑定患者知情同意与权限分块。" FontSize="11" Foreground="{DynamicResource SemiColorText2}" TextWrapping="Wrap"/>

                                <TextBlock Text="患者编号 (Patient ID):" FontSize="12"/>
                                <TextBox Text="{Binding GrantPatientId, Mode=TwoWay}" PlaceholderText="输入患者编号"/>

                                <TextBlock Text="被授权医师工号/账号:" FontSize="12"/>
                                <TextBox Text="{Binding GranteeUserId, Mode=TwoWay}" PlaceholderText="输入医师工号"/>

                                <TextBlock Text="授权有效时长 (小时):" FontSize="12"/>
                                <TextBox Text="{Binding GrantValidHours, Mode=TwoWay}"/>

                                <CheckBox Content="标记为医联体/跨院外院经授权医师访问" IsChecked="{Binding GrantIsExternal, Mode=TwoWay}"/>

                                <TextBlock Text="授权调阅范围 (逗号分隔):" FontSize="12"/>
                                <TextBox Text="{Binding GrantAllowedScopes, Mode=TwoWay}" PlaceholderText="EMR,LAB,PACS"/>

                                <TextBlock Text="授权事由依据:" FontSize="12"/>
                                <TextBox Text="{Binding GrantReason, Mode=TwoWay}" Height="60" AcceptsReturn="True" TextWrapping="Wrap"/>

                                <Button Content="颁发经审批限时访问授权" Classes="Primary" HorizontalAlignment="Stretch" Height="34"
                                        Command="{Binding CreateAccessGrantCommand}"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
