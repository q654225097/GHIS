<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:HIS.Client.UrsaShell.Stations.MasterDict"
             xmlns:catalog="using:HIS.Client.UrsaShell.Stations.MasterCatalog"
             x:Class="HIS.Client.UrsaShell.Stations.MasterDict.MasterDictStationView"
             x:DataType="local:MasterDictViewModel">
    <Grid RowDefinitions="Auto,*" Margin="14" RowSpacing="10">
        <Border Grid.Row="0" Padding="14,10" CornerRadius="8"
                Background="{DynamicResource SemiColorBackground1}"
                BorderBrush="{DynamicResource SemiColorBorder}" BorderThickness="1">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <StackPanel Spacing="2">
                    <TextBlock Text="全院统一主数据中心" FontSize="17" FontWeight="Bold"/>
                    <TextBlock Text="{Binding MdmSummaryBanner}" FontSize="12" Foreground="{DynamicResource SemiColorText2}"/>
                </StackPanel>
                <Button Grid.Column="1" Content="刷新字典" Classes="Primary" Height="32" Command="{Binding RefreshCommand}"/>
            </Grid>
        </Border>

        <TabControl Grid.Row="1">
            <!-- Tab 1: 通用参考值域字典 -->
            <TabItem Header="通用参考值域字典 (WS/T 364)">
                <Grid ColumnDefinitions="360,*" ColumnSpacing="12" Margin="0,10,0,0">
                    <Border Grid.Column="0" Padding="12" CornerRadius="8"
                            Background="{DynamicResource SemiColorBackground1}"
                            BorderBrush="{DynamicResource SemiColorBorder}" BorderThickness="1">
                        <Grid RowDefinitions="Auto,*,Auto" RowSpacing="8">
                            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                <TextBox Grid.Column="0" Text="{Binding SearchKeyword, Mode=TwoWay}" PlaceholderText="搜索字典编码或名称"/>
                                <Button Grid.Column="1" Content="查询" Classes="Secondary" Command="{Binding RefreshCommand}"/>
                            </Grid>
                            <ListBox Grid.Row="1" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory, Mode=TwoWay}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="local:DictCategoryRow">
                                        <Border Padding="8,6" Margin="0,2" CornerRadius="6" BorderBrush="{DynamicResource SemiColorBorder}" BorderThickness="1">
                                            <StackPanel Spacing="2">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <TextBlock Grid.Column="0" Text="{Binding DictName}" FontWeight="SemiBold"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding BadgeText}" FontSize="11" Foreground="{DynamicResource SemiColorPrimary}"/>
                                                </Grid>
                                                <TextBlock Text="{Binding DictType}" FontSize="11" Foreground="{DynamicResource SemiColorText2}"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <Border Grid.Row="2" Padding="8" CornerRadius="6" Background="{DynamicResource SemiColorBackground2}">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="新增自定义字典分类" FontWeight="SemiBold" FontSize="12"/>
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                                        <TextBox Grid.Column="0" Text="{Binding NewCatType, Mode=TwoWay}" PlaceholderText="编码 如 PAIN_LEVEL"/>
                                        <TextBox Grid.Column="1" Text="{Binding NewCatName, Mode=TwoWay}" PlaceholderText="名称 如 疼痛评分"/>
                                    </Grid>
                                    <Grid ColumnDefinitions="120,*" ColumnSpacing="6">
                                        <ComboBox Grid.Column="0" HorizontalAlignment="Stretch" ItemsSource="{Binding CategoryGroups}" SelectedItem="{Binding NewCatGroup, Mode=TwoWay}"/>
                                        <Button Grid.Column="1" Content="保存字典分类" Classes="Primary" HorizontalAlignment="Stretch" Command="{Binding SaveCategoryCommand}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1" Padding="12" CornerRadius="8"
                            Background="{DynamicResource SemiColorBackground1}"
                            BorderBrush="{DynamicResource SemiColorBorder}" BorderThickness="1">
                        <Grid RowDefinitions="Auto,*" RowSpacing="10">
                            <WrapPanel Grid.Row="0" Orientation="Horizontal">
                                <TextBox Text="{Binding ItemCode, Mode=TwoWay}" Width="110" Margin="0,0,6,6" PlaceholderText="项编码 (如 mg)"/>
                                <TextBox Text="{Binding ItemName, Mode=TwoWay}" Width="140" Margin="0,0,6,6" PlaceholderText="显示名称"/>
                                <TextBox Text="{Binding ItemPinyin, Mode=TwoWay}" Width="80" Margin="0,0,6,6" PlaceholderText="拼音码"/>
                                <TextBox Text="{Binding ItemStdMappingCode, Mode=TwoWay}" Width="140" Margin="0,0,6,6" PlaceholderText="国标映射码"/>
                                <NumericUpDown Value="{Binding ItemSortOrder, Mode=TwoWay}" Minimum="1" Maximum="999" Width="85" Margin="0,0,6,6" FormatString="0"/>
                                <CheckBox Content="默认项" IsChecked="{Binding ItemIsDefault, Mode=TwoWay}" Margin="0,0,8,6" VerticalAlignment="Center"/>
                                <Button Content="保存/新增字典项" Classes="Primary" Margin="0,0,6,6" Command="{Binding SaveItemCommand}"/>
                                <Button Content="启用 / 停用选中项" Classes="Warning" Margin="0,0,6,6" Command="{Binding ToggleItemCommand}"/>
                            </WrapPanel>

                            <DataGrid Grid.Row="1" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                                      AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="排序" Binding="{Binding SortOrder}" Width="60"/>
                                    <DataGridTextColumn Header="项编码" Binding="{Binding ItemCode}" Width="120"/>
                                    <DataGridTextColumn Header="字典项显示名称" Binding="{Binding ItemName}" Width="*"/>
                                    <DataGridTextColumn Header="国标/行标映射码" Binding="{Binding StdMappingCode}" Width="150"/>
                                    <DataGridTextColumn Header="拼音码" Binding="{Binding PinyinCode}" Width="85"/>
                                    <DataGridTextColumn Header="默认" Binding="{Binding DefaultDisplay}" Width="65"/>
                                    <DataGridTextColumn Header="状态" Binding="{Binding StatusDisplay}" Width="90"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Tab 2: 药品、耗材与诊疗套餐目录（统一归口主数据中心） -->
            <TabItem Header="药品、耗材与诊疗套餐目录">
                <catalog:MasterCatalogStationView DataContext="{Binding Catalog}"/>
            </TabItem>

            <!-- Tab 3: 全院 34 大主数据域标准治理 -->
            <TabItem Header="全院 34 大主数据域治理">
                <Grid ColumnDefinitions="340,*" ColumnSpacing="12" Margin="0,10,0,0">
                    <Border Grid.Column="0" Padding="10" CornerRadius="8"
                            Background="{DynamicResource SemiColorBackground1}"
                            BorderBrush="{DynamicResource SemiColorBorder}" BorderThickness="1">
                        <ListBox ItemsSource="{Binding MdmDomains}" SelectedItem="{Binding SelectedMdmDomain, Mode=TwoWay}">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="local:MdmDomainDescriptor">
                                    <Border Padding="8,6" Margin="0,2" CornerRadius="6" BorderBrush="{DynamicResource SemiColorBorder}" BorderThickness="1">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding PrimaryKeySpec}" FontSize="11" Foreground="{DynamicResource SemiColorPrimary}"/>
                                            <TextBlock Text="{Binding StandardSpec}" FontSize="11" Foreground="{DynamicResource SemiColorText2}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>

                    <Border Grid.Column="1" Padding="12" CornerRadius="8"
                            Background="{DynamicResource SemiColorBackground1}"
                            BorderBrush="{DynamicResource SemiColorBorder}" BorderThickness="1">
                        <Grid RowDefinitions="Auto,Auto,*" RowSpacing="10">
                            <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                <TextBox Grid.Column="0" Text="{Binding MdmSearchKeyword, Mode=TwoWay}" PlaceholderText="按编码、名称或国标码过滤当前主数据域..."/>
                                <Button Grid.Column="1" Content="查询域数据" Classes="Secondary" Command="{Binding RefreshMdmCommand}"/>
                                <Button Grid.Column="2" Content="刷新总览" Classes="Primary" Command="{Binding RefreshMdmCommand}"/>
                            </Grid>

                            <WrapPanel Grid.Row="1" Orientation="Horizontal">
                                <TextBox Text="{Binding MdmQuickCode, Mode=TwoWay}" Width="130" Margin="0,0,6,6" PlaceholderText="业务编码 *"/>
                                <TextBox Text="{Binding MdmQuickName, Mode=TwoWay}" Width="160" Margin="0,0,6,6" PlaceholderText="标准名称 *"/>
                                <TextBox Text="{Binding MdmQuickStdCode, Mode=TwoWay}" Width="150" Margin="0,0,6,6" PlaceholderText="国标/医保/LOINC码"/>
                                <TextBox Text="{Binding MdmQuickCategory, Mode=TwoWay}" Width="130" Margin="0,0,6,6" PlaceholderText="分类/规格/权重"/>
                                <TextBox Text="{Binding MdmQuickExtra, Mode=TwoWay}" Width="150" Margin="0,0,6,6" PlaceholderText="附加属性/参考范围"/>
                                <Button Content="保存修改 / 新增" Classes="Primary" Margin="0,0,6,6" Command="{Binding SaveMdmQuickCommand}"/>
                                <Button Content="启用 / 停用" Classes="Secondary" Margin="0,0,6,6" Command="{Binding ToggleMdmRecordCommand}"/>
                                <Button Content="清空新增" Classes="Tertiary" Margin="0,0,6,6" Command="{Binding NewMdmRecordCommand}"/>
                            </WrapPanel>

                            <DataGrid Grid.Row="2" ItemsSource="{Binding MdmRows}" SelectedItem="{Binding SelectedMdmRow, Mode=TwoWay}" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="业务编码" Binding="{Binding Code}" Width="130"/>
                                    <DataGridTextColumn Header="标准名称" Binding="{Binding Name}" Width="200"/>
                                    <DataGridTextColumn Header="国标/行标/医保编码" Binding="{Binding StandardCode}" Width="210"/>
                                    <DataGridTextColumn Header="分类/规格" Binding="{Binding CategoryOrSpec}" Width="150"/>
                                    <DataGridTextColumn Header="扩展属性" Binding="{Binding ExtraAttributes}" Width="*"/>
                                    <DataGridTextColumn Header="状态" Binding="{Binding StatusText}" Width="75"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
