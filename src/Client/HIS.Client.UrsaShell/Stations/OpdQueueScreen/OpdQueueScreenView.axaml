<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:HIS.Client.UrsaShell.Stations.OpdQueueScreen"
             xmlns:controls="using:HIS.Client.UrsaShell.Shell.Controls"
             x:Class="HIS.Client.UrsaShell.Stations.OpdQueueScreen.OpdQueueScreenView"
             x:DataType="local:OpdQueueScreenViewModel">

    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="20" Background="{DynamicResource SemiColorBackground0}">
        <!-- Header Bar -->
        <Border Grid.Row="0"
                Background="{DynamicResource SemiColorBackground1}"
                BorderBrush="{DynamicResource SemiColorBorder}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16,12"
                Margin="0,0,0,16">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBlock Text="🏥" FontSize="24" VerticalAlignment="Center"/>
                    <StackPanel>
                        <TextBlock Text="{Binding DeptName}"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource SemiColorText0}"/>
                        <TextBlock Text="智能门诊排队叫号发布大屏 · 实时推流"
                                   FontSize="11"
                                   Foreground="{DynamicResource SemiColorText2}"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center" Margin="0,0,16,0">
                    <Border Background="{DynamicResource SemiColorSuccessLight}" CornerRadius="4" Padding="8,4">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Ellipse Width="8" Height="8" Fill="{DynamicResource SemiColorSuccess}"/>
                            <TextBlock Text="SignalR 实时推流在线" FontSize="11" Foreground="{DynamicResource SemiColorSuccess}" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="{Binding CurrentTimeText}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource SemiColorPrimary}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <Button Grid.Column="3"
                        Content="刷新大屏"
                        Classes="Secondary"
                        Command="{Binding RefreshCommand}"
                        VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Spotlight: Active Call Spotlight Card -->
        <Border Grid.Row="1"
                Background="{DynamicResource SemiColorPrimaryLight}"
                BorderBrush="{DynamicResource SemiColorPrimary}"
                BorderThickness="2"
                CornerRadius="8"
                Padding="24,18"
                Margin="0,0,0,16">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="4">
                    <TextBlock Text="当前正在呼叫"
                               FontSize="13"
                               FontWeight="Bold"
                               Foreground="{DynamicResource SemiColorPrimary}"/>
                    <TextBlock Text="{Binding CurrentCallTicket}"
                               FontSize="42"
                               FontWeight="Black"
                               Foreground="{DynamicResource SemiColorPrimary}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="32,0,0,0" Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <TextBlock Text="{Binding CurrentCallPatient}"
                                   FontSize="32"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource SemiColorText0}"/>
                        <Border Background="{DynamicResource SemiColorPrimary}" CornerRadius="4" Padding="10,4" VerticalAlignment="Center">
                            <TextBlock Text="请进入诊室" FontSize="14" FontWeight="Bold" Foreground="White"/>
                        </Border>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="24">
                        <TextBlock Text="{Binding CurrentCallRoom, StringFormat='就诊诊室: {0}'}"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource SemiColorText1}"/>
                        <TextBlock Text="{Binding CurrentCallDoctor, StringFormat='接诊医生: {0}'}"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource SemiColorText1}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Audio Broadcast Pulse -->
                <Border Grid.Column="2"
                        Background="{DynamicResource SemiColorBackground1}"
                        CornerRadius="8"
                        Padding="16,10"
                        VerticalAlignment="Center"
                        BorderBrush="{DynamicResource SemiColorBorder}"
                        BorderThickness="1">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="📢" FontSize="24" VerticalAlignment="Center"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="语音播报已下发" FontSize="11" Foreground="{DynamicResource SemiColorText2}"/>
                            <TextBlock Text="{Binding TtsAnnouncement}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource SemiColorText0}"
                                       MaxWidth="320"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Lower Grid: Waiting Queue & Passed/Doctor Matrix -->
        <Grid Grid.Row="2" ColumnDefinitions="3*,2*" Margin="0,0,0,16">
            <!-- Left: Waiting Patients Matrix -->
            <Border Grid.Column="0"
                    Background="{DynamicResource SemiColorBackground1}"
                    BorderBrush="{DynamicResource SemiColorBorder}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16"
                    Margin="0,0,12,0">
                <Grid RowDefinitions="Auto,*">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="⏳ 候诊队列" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource SemiColorText0}"/>
                            <TextBlock Text="{Binding WaitingList.Count, StringFormat='({0} 位患者候诊中)'}"
                                       FontSize="13"
                                       Foreground="{DynamicResource SemiColorText2}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="按报到先后次序候诊" FontSize="11" Foreground="{DynamicResource SemiColorText2}" VerticalAlignment="Center"/>
                    </Grid>

                    <ScrollViewer Grid.Row="1">
                        <ItemsControl ItemsSource="{Binding WaitingList}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:OpdScreenWaitingModel">
                                    <Border Width="190"
                                            Margin="0,0,10,10"
                                            Padding="12,10"
                                            Background="{DynamicResource SemiColorBackground0}"
                                            BorderBrush="{DynamicResource SemiColorBorder}"
                                            BorderThickness="1"
                                            CornerRadius="6">
                                        <Grid ColumnDefinitions="Auto,*">
                                            <Border Grid.Column="0"
                                                    Background="{DynamicResource SemiColorPrimaryLight}"
                                                    CornerRadius="4"
                                                    Padding="8,4"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding TicketNo}"
                                                           FontWeight="Bold"
                                                           FontSize="15"
                                                           Foreground="{DynamicResource SemiColorPrimary}"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="{Binding PatientName}"
                                                           FontWeight="Bold"
                                                           FontSize="15"
                                                           Foreground="{DynamicResource SemiColorText0}"/>
                                                <TextBlock Text="{Binding DoctorName}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource SemiColorText2}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Right: Passed / Deferred Queue & Room Status -->
            <Grid Grid.Column="1" RowDefinitions="*,*">
                <!-- Top Right: Doctor Consultation Status -->
                <Border Grid.Row="0"
                        Background="{DynamicResource SemiColorBackground1}"
                        BorderBrush="{DynamicResource SemiColorBorder}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16"
                        Margin="0,0,0,12">
                    <Grid RowDefinitions="Auto,*">
                        <TextBlock Grid.Row="0" Text="👨‍⚕️ 诊室接诊动态" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource SemiColorText0}" Margin="0,0,0,10"/>
                        <ScrollViewer Grid.Row="1">
                            <ItemsControl ItemsSource="{Binding CallingList}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="local:OpdScreenCallingModel">
                                        <Border Margin="0,0,0,8"
                                                Padding="10,8"
                                                Background="{DynamicResource SemiColorBackground0}"
                                                BorderBrush="{DynamicResource SemiColorBorder}"
                                                BorderThickness="1"
                                                CornerRadius="6">
                                            <Grid ColumnDefinitions="Auto,*,Auto">
                                                <TextBlock Grid.Column="0" Text="{Binding RoomName}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource SemiColorText0}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding DoctorName, StringFormat=' - {0}'}" FontSize="12" Foreground="{DynamicResource SemiColorText2}" VerticalAlignment="Center"/>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                                                    <TextBlock Text="{Binding TicketNo}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource SemiColorPrimary}"/>
                                                    <TextBlock Text="{Binding PatientName}" FontSize="12" FontWeight="SemiBold"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- Bottom Right: Passed / Deferred List -->
                <Border Grid.Row="1"
                        Background="{DynamicResource SemiColorBackground1}"
                        BorderBrush="{DynamicResource SemiColorBorder}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16">
                    <Grid RowDefinitions="Auto,*">
                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
                            <TextBlock Grid.Column="0" Text="⚠️ 过号顺延患者" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource SemiColorWarning}"/>
                            <TextBlock Grid.Column="1" Text="过号患者请前往导医台激活" FontSize="10" Foreground="{DynamicResource SemiColorText2}" VerticalAlignment="Center"/>
                        </Grid>

                        <ScrollViewer Grid.Row="1">
                            <ItemsControl ItemsSource="{Binding PassedList}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="local:OpdScreenPassedModel">
                                        <Border Margin="0,0,8,8"
                                                Padding="8,6"
                                                Background="{DynamicResource SemiColorWarningLight}"
                                                BorderBrush="{DynamicResource SemiColorWarning}"
                                                BorderThickness="1"
                                                CornerRadius="4">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="{Binding TicketNo}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource SemiColorWarning}"/>
                                                <TextBlock Text="{Binding PatientName}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SemiColorText0}"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- Bottom Announcement Banner -->
        <Border Grid.Row="3"
                Background="{DynamicResource SemiColorBackground1}"
                BorderBrush="{DynamicResource SemiColorBorder}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12,8">
            <Grid ColumnDefinitions="Auto,*">
                <TextBlock Grid.Column="0" Text="温馨提示：" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource SemiColorPrimary}"/>
                <TextBlock Grid.Column="1"
                           Text="请就诊患者持身份证、社保卡或电子就医码在候诊区安静等候叫号，听到叫号语音后根据屏幕提示前往对应诊室就诊。"
                           FontSize="12"
                           Foreground="{DynamicResource SemiColorText1}"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
