<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:HIS.Client.UrsaShell.Stations.Equipment"
             x:Class="HIS.Client.UrsaShell.Stations.Equipment.EquipmentStationView"
             x:DataType="local:EquipmentStationViewModel">
    <Grid RowDefinitions="Auto,*" Margin="14" RowSpacing="10">
        <Border Grid.Row="0" Background="{DynamicResource SemiColorBackground1}" BorderBrush="{DynamicResource SemiColorBorder}" BorderThickness="1" CornerRadius="8" Padding="14,10">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="3">
                    <TextBlock Text="医疗设备与大型仪器计量维保中心" FontSize="17" FontWeight="Bold"/>
                    <TextBlock Text="{Binding SummaryText}" FontSize="11" Foreground="{DynamicResource SemiColorPrimary}" FontWeight="SemiBold"/>
                </StackPanel>
                <Button Grid.Column="1" Content="刷新台账" Classes="Primary" Height="30" Command="{Binding RefreshCommand}"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="360,*" ColumnSpacing="12">
            <Border Grid.Column="0" Background="{DynamicResource SemiColorBackground1}" BorderBrush="{DynamicResource SemiColorBorder}" BorderThickness="1" CornerRadius="8" Padding="14">
                <ScrollViewer>
                    <StackPanel Spacing="8">
                        <TextBlock Text="1. 新购设备建档登记" FontSize="14" FontWeight="Bold"/>
                        <TextBox Text="{Binding Code, Mode=TwoWay}" PlaceholderText="设备唯一编码" Height="30"/>
                        <TextBox Text="{Binding Name, Mode=TwoWay}" PlaceholderText="设备名称" Height="30"/>
                        <TextBox Text="{Binding ModelSpec, Mode=TwoWay}" PlaceholderText="型号规格" Height="30"/>
                        <TextBox Text="{Binding DeptId, Mode=TwoWay}" PlaceholderText="使用科室ID" Height="30"/>
                        <NumericUpDown Value="{Binding Price, Mode=TwoWay}" Minimum="0" Height="30"/>
                        <CheckBox Content="强检计量设备 (到期须校准)" IsChecked="{Binding IsMandatory, Mode=TwoWay}"/>
                        <Button Content="登记固定资产卡片" Classes="Primary" Height="32" Command="{Binding RegisterEquipmentCommand}"/>

                        <TextBlock Text="2. 选中设备 PM 维保 / 计量校准" FontSize="14" FontWeight="Bold" Margin="0,10,0,0"/>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                            <ComboBox Grid.Column="0" ItemsSource="{Binding MaintTypes}" SelectedItem="{Binding MaintType, Mode=TwoWay}" Height="30"/>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding MaintResults}" SelectedItem="{Binding MaintResult, Mode=TwoWay}" Height="30"/>
                        </Grid>
                        <TextBox Text="{Binding MaintEngineer, Mode=TwoWay}" PlaceholderText="工程师姓名" Height="30"/>
                        <Button Content="归档维保/强检记录" Classes="Success" Height="32" Command="{Binding RecordMaintenanceCommand}"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Border Grid.Column="1" Background="{DynamicResource SemiColorBackground1}" BorderBrush="{DynamicResource SemiColorBorder}" BorderThickness="1" CornerRadius="8" Padding="12">
                <ListBox ItemsSource="{Binding Equipments}" SelectedItem="{Binding SelectedEquipment, Mode=TwoWay}" Background="Transparent" BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="local:EquipmentItemVm">
                            <Border Background="{DynamicResource SemiColorBackground0}" BorderBrush="{DynamicResource SemiColorBorder}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                                <TextBlock Text="{Binding DisplayLine}" FontSize="12" TextWrapping="Wrap"/>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </Grid>
    </Grid>
</UserControl>
