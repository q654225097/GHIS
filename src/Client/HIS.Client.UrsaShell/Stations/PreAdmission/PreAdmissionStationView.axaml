<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:HIS.Client.UrsaShell.Stations.PreAdmission"
             xmlns:controls="using:HIS.Client.UrsaShell.Shell.Controls"
             x:Class="HIS.Client.UrsaShell.Stations.PreAdmission.PreAdmissionStationView"
             x:DataType="local:PreAdmissionViewModel">
    <Grid RowDefinitions="Auto,*" Margin="14" RowSpacing="10">
        <!-- 顶部 KPI 与动态打印触发栏 -->
        <Border Grid.Row="0" Padding="14,10" CornerRadius="8"
                Background="{DynamicResource SemiColorBackground1}"
                BorderBrush="{DynamicResource SemiColorBorder}" BorderThickness="1">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                <StackPanel Spacing="3">
                    <TextBlock Text="医保“预住院”管理与入院准备中心" FontSize="17" FontWeight="Bold"/>
                    <StackPanel Orientation="Horizontal" Spacing="14">
                        <TextBlock Text="{Binding ActiveCount, StringFormat=在管预住院 {0}}" FontSize="12" Foreground="{DynamicResource SemiColorPrimary}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding CriticalInterruptedCount, StringFormat=P0危急值中断 {0}}" FontSize="12" Foreground="{DynamicResource SemiColorDanger}" FontWeight="Bold"/>
                        <TextBlock Text="{Binding PendingEvalCount, StringFormat=齐套待评估 {0}}" FontSize="12" Foreground="{DynamicResource SemiColorWarning}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding ReadyToAdmitCount, StringFormat=待占床入科 {0}}" FontSize="12" Foreground="{DynamicResource SemiColorSuccess}"/>
                        <TextBlock Text="{Binding ConvertedIpdCount, StringFormat=已转住院 {0}}" FontSize="12" Foreground="{DynamicResource SemiColorText2}"/>
                        <TextBlock Text="{Binding ConvertedOpdCount, StringFormat=已转门诊 {0}}" FontSize="12" Foreground="{DynamicResource SemiColorText2}"/>
                        <TextBlock Text="{Binding ExpiringSoonCount, StringFormat=即将超期预警 {0}}" FontSize="12" Foreground="{DynamicResource SemiColorWarning}"/>
                    </StackPanel>
                </StackPanel>
                <controls:DynamicPrintTriggerBar Grid.Column="1" PageKey="pre_admission" TriggerSlot="TOP_TOOLBAR"/>
                <Button Grid.Column="2" Content="刷新" Classes="Primary" Height="32" Command="{Binding RefreshCommand}"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="360,*" ColumnSpacing="12">
            <!-- 左侧：在管预住院队列 -->
            <Border Grid.Column="0" CornerRadius="8" Padding="10"
                    Background="{DynamicResource SemiColorBackground1}"
                    BorderBrush="{DynamicResource SemiColorBorder}" BorderThickness="1">
                <Grid RowDefinitions="Auto,Auto,*" RowSpacing="8">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="6">
                        <TextBox Grid.Column="0" Text="{Binding SearchKeyword, Mode=TwoWay}" PlaceholderText="预住院号 / 姓名 / 诊断 / 科室"/>
                        <Button Grid.Column="1" Content="查询" Classes="Secondary" Command="{Binding SearchCommand}"/>
                    </Grid>
                    <ComboBox Grid.Row="1" HorizontalAlignment="Stretch" ItemsSource="{Binding StatusFilterOptions}" SelectedItem="{Binding FilterStatus, Mode=TwoWay}"/>
                    <ListBox Grid.Row="2" ItemsSource="{Binding PreAdmissions}" SelectedItem="{Binding SelectedMain, Mode=TwoWay}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="local:PreAdmissionRow">
                                <Border Padding="8,6" Margin="0,2" CornerRadius="6" BorderBrush="{DynamicResource SemiColorBorder}" BorderThickness="1">
                                    <StackPanel Spacing="2">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Grid.Column="0" FontWeight="SemiBold">
                                                <Run Text="{Binding PatientName}"/>
                                                <Run Text=" ("/>
                                                <Run Text="{Binding Gender}"/>
                                                <Run Text=" "/>
                                                <Run Text="{Binding Age}"/>
                                                <Run Text="岁)"/>
                                            </TextBlock>
                                            <TextBlock Grid.Column="1" Text="{Binding StatusDisplay}" FontSize="11" Foreground="{DynamicResource SemiColorPrimary}" FontWeight="SemiBold"/>
                                        </Grid>
                                        <TextBlock FontSize="11" Text="{Binding PrimaryDiagName, StringFormat=A诊断：{0}}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock FontSize="10" Foreground="{DynamicResource SemiColorText2}">
                                            <Run Text="{Binding TargetDeptName}"/>
                                            <Run Text=" · 有效期至 "/>
                                            <Run Text="{Binding ValidUntilText}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- 右侧四大业务页签 -->
            <TabControl Grid.Column="1" SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">
                <!-- Tab 1: 预住院登记与院前检查开立（白名单拦截） -->
                <TabItem Header="1. 预住院登记与院前开单">
                    <Border CornerRadius="8" Padding="14" Margin="0,8,0,0"
                            Background="{DynamicResource SemiColorBackground1}"
                            BorderBrush="{DynamicResource SemiColorBorder}" BorderThickness="1">
                        <ScrollViewer>
                            <StackPanel Spacing="12">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="新患者预住院登记（自动签存 PRE_ADMIT 知情同意书并拆解术前套餐）" FontSize="15" FontWeight="Bold"/>
                                    <Button Grid.Column="1" Content="确认预住院登记" Classes="Primary" Command="{Binding RegisterCommand}"/>
                                </Grid>
                                <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="8">
                                    <StackPanel Grid.Row="0" Grid.Column="0" Spacing="2">
                                        <TextBlock Text="患者姓名 *" FontSize="11"/>
                                        <TextBox Text="{Binding RegPatientName, Mode=TwoWay}" PlaceholderText="如：张三"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="1" Spacing="2">
                                        <TextBlock Text="性别 / 年龄" FontSize="11"/>
                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="4">
                                            <ComboBox Grid.Column="0" HorizontalAlignment="Stretch" ItemsSource="{Binding GenderOptions}" SelectedItem="{Binding RegGender, Mode=TwoWay}"/>
                                            <NumericUpDown Grid.Column="1" Minimum="0" Maximum="120" FormatString="0" Value="{Binding RegAge, Mode=TwoWay}"/>
                                        </Grid>
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="2" Spacing="2">
                                        <TextBlock Text="拟入院科室" FontSize="11"/>
                                        <TextBox Text="{Binding RegTargetDept, Mode=TwoWay}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Grid.Column="0" Spacing="2">
                                        <TextBlock Text="拟入院主诊断（A诊断）*" FontSize="11"/>
                                        <TextBox Text="{Binding RegPrimaryDiag, Mode=TwoWay}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="1" Spacing="2">
                                        <TextBlock Text="拟行择期手术/治疗" FontSize="11"/>
                                        <TextBox Text="{Binding RegPlannedSurgery, Mode=TwoWay}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="2" Spacing="2">
                                        <TextBlock Text="一键拆解术前组合套餐" FontSize="11"/>
                                        <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding Bundles}" SelectedItem="{Binding RegSelectedBundle, Mode=TwoWay}"/>
                                    </StackPanel>

                                    <CheckBox Grid.Row="2" Grid.ColumnSpan="3"
                                              Content="患方已签署《预住院患者知情同意书》（知晓未转正式住院费用按门诊政策结算）"
                                              IsChecked="{Binding RegConsentSigned, Mode=TwoWay}" FontWeight="SemiBold"/>
                                </Grid>

                                <!-- 选中预住院单加开院前项目（含医保白名单强拦截） -->
                                <Border Padding="10" CornerRadius="6" BorderBrush="{DynamicResource SemiColorPrimary}" BorderThickness="1" IsEnabled="{Binding HasSelectedMain}">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="为当前选中预住院患者加开院前检查（选择 BED/NURSING/IPD_CONSULT 将触发医保硬拦截）" FontWeight="SemiBold" FontSize="12"/>
                                        <Grid ColumnDefinitions="130,*,110,90,Auto" ColumnSpacing="6">
                                            <ComboBox Grid.Column="0" HorizontalAlignment="Stretch" ItemsSource="{Binding FeeCategoryOptions}" SelectedItem="{Binding AddOrderCat, Mode=TwoWay}"/>
                                            <TextBox Grid.Column="1" Text="{Binding AddOrderName, Mode=TwoWay}" PlaceholderText="检查/检验项目名称"/>
                                            <TextBox Grid.Column="2" Text="{Binding AddOrderDept, Mode=TwoWay}" PlaceholderText="执行科室"/>
                                            <NumericUpDown Grid.Column="3" Minimum="0" Maximum="9999" FormatString="0.00" Value="{Binding AddOrderAmount, Mode=TwoWay}"/>
                                            <Button Grid.Column="4" Content="+ 暂挂开立" Classes="Primary" Command="{Binding AddOrderCommand}"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </TabItem>

                <!-- Tab 2: 结果导向准入评估与 P0 危急值抢占处置 -->
                <TabItem Header="2. 结果评估与P0危急值处置">
                    <Border CornerRadius="8" Padding="14" Margin="0,8,0,0"
                            Background="{DynamicResource SemiColorBackground1}"
                            BorderBrush="{DynamicResource SemiColorBorder}" BorderThickness="1">
                        <ScrollViewer>
                            <StackPanel Spacing="10" IsEnabled="{Binding HasSelectedMain}">
                                <!-- P0 危急值告警横幅 -->
                                <Border Padding="10" CornerRadius="6" BorderBrush="{DynamicResource SemiColorDanger}" BorderThickness="1"
                                        IsVisible="{Binding SelectedMain.HasCriticalAlert}">
                                    <StackPanel Spacing="3">
                                        <TextBlock FontWeight="Bold" Foreground="{DynamicResource SemiColorDanger}">
                                            <Run Text="⚠ P0 危急值抢占中断已触发 — 检出 B 诊断："/>
                                            <Run Text="{Binding SelectedMain.CriticalDiagName}"/>
                                        </TextBlock>
                                        <TextBlock Text="{Binding SelectedMain.CriticalSummary}" FontSize="12" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <!-- 模拟/接收 B 诊断危急值中断测试栏 -->
                                <Border Padding="8" CornerRadius="6" BorderBrush="{DynamicResource SemiColorWarning}" BorderThickness="1">
                                    <Grid ColumnDefinitions="180,*,Auto" ColumnSpacing="6">
                                        <TextBox Grid.Column="0" Text="{Binding CritDiagName, Mode=TwoWay}" PlaceholderText="B诊断名称"/>
                                        <TextBox Grid.Column="1" Text="{Binding CritSummary, Mode=TwoWay}" PlaceholderText="危急值摘要"/>
                                        <Button Grid.Column="2" Content="⚡ 触发B诊断P0危急值中断" Classes="Danger" Command="{Binding TriggerCriticalCommand}"/>
                                    </Grid>
                                </Border>

                                <!-- 检查明细与医生建议拆分勾选（复合拆分第一关） -->
                                <TextBlock Text="院前检查与费用暂挂明细（B诊断转入院时，医生可先勾选建议拆回门诊的无关项目）" FontWeight="SemiBold" FontSize="12"/>
                                <ItemsControl ItemsSource="{Binding SelectedOrders}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="local:PreAdmissionOrderRow">
                                            <Border Padding="8,5" Margin="0,2" CornerRadius="5" BorderBrush="{DynamicResource SemiColorBorder}" BorderThickness="1">
                                                <Grid ColumnDefinitions="*,120,75,100,130" ColumnSpacing="6">
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="{Binding ItemName}" FontWeight="SemiBold" FontSize="12"/>
                                                        <TextBlock Text="{Binding ResultSummary}" FontSize="10" Foreground="{DynamicResource SemiColorText2}" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Text="{Binding ExecStatusDisplay}" FontSize="11" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding Amount, StringFormat=¥{0:0.00}}" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding TrackDisplay}" FontSize="11" Foreground="{DynamicResource SemiColorPrimary}" VerticalAlignment="Center"/>
                                                    <ComboBox Grid.Column="4" HorizontalAlignment="Stretch"
                                                              ItemsSource="{Binding $parent[UserControl].((local:PreAdmissionViewModel)DataContext).SplitActionOptions}"
                                                              SelectedItem="{Binding DoctorSplitSuggest, Mode=TwoWay}"
                                                              IsEnabled="{Binding IsDone}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- 医生准入/危急值决策签署区 -->
                                <Border Padding="10" CornerRadius="6" BorderBrush="{DynamicResource SemiColorPrimary}" BorderThickness="1">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="临床评估与危急值处置决策（签署 SM3 电子签名并自动流转）" FontWeight="Bold"/>
                                        <Grid ColumnDefinitions="200,*,*" ColumnSpacing="8">
                                            <ComboBox Grid.Column="0" HorizontalAlignment="Stretch" ItemsSource="{Binding DecisionOptions}" SelectedItem="{Binding EvalDecision, Mode=TwoWay}"/>
                                            <TextBox Grid.Column="1" Text="{Binding EvalNewDiag, Mode=TwoWay}" PlaceholderText="若切换B诊断，填写新主诊断"/>
                                            <TextBox Grid.Column="2" Text="{Binding EvalNewDept, Mode=TwoWay}" PlaceholderText="若跨科收治，填写目标专科"/>
                                        </Grid>
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <TextBox Grid.Column="0" Text="{Binding EvalReason, Mode=TwoWay}" PlaceholderText="评估依据与临床意见说明"/>
                                            <Button Grid.Column="1" Content="✓ 签发评估决策" Classes="Primary" Command="{Binding EvaluateCommand}"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </TabItem>

                <!-- Tab 3: 正式占床入科 & 财务/医保复合拆分终审 -->
                <TabItem Header="3. 正式入科与财务复合拆分终审">
                    <Border CornerRadius="8" Padding="14" Margin="0,8,0,0"
                            Background="{DynamicResource SemiColorBackground1}"
                            BorderBrush="{DynamicResource SemiColorBorder}" BorderThickness="1">
                        <ScrollViewer>
                            <StackPanel Spacing="12" IsEnabled="{Binding HasSelectedMain}">
                                <Border Padding="10" CornerRadius="6" BorderBrush="{DynamicResource SemiColorSuccess}" BorderThickness="1">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="常规准予住院 → 办理正式入科占床（锚定正式入院时间，合并 PRE_ADMIT_HOLD 费用与文书并卷）" FontWeight="Bold"/>
                                        <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="8">
                                            <TextBox Grid.Column="0" Text="{Binding AdmitWardName, Mode=TwoWay}" PlaceholderText="入科病区"/>
                                            <TextBox Grid.Column="1" Text="{Binding AdmitBedCode, Mode=TwoWay}" PlaceholderText="分配床号"/>
                                            <Button Grid.Column="2" Content="办理正式占床入科" Classes="Success" Command="{Binding ConvertToInpatientCommand}"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- 财务/医保复合拆分第二道终审关口 -->
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="财务 / 医保费用复合拆分终审（可采纳或调整医生建议，最终锁定合并住院 vs 拆回门诊）" FontWeight="Bold"/>
                                    <Button Grid.Column="1" Content="确认终审拆分结果" Classes="Primary" Command="{Binding FinanceConfirmSplitCommand}"/>
                                </Grid>

                                <ItemsControl ItemsSource="{Binding SelectedOrders}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="local:PreAdmissionOrderRow">
                                            <Border Padding="8,5" Margin="0,2" CornerRadius="5" BorderBrush="{DynamicResource SemiColorBorder}" BorderThickness="1">
                                                <Grid ColumnDefinitions="*,80,110,120,140" ColumnSpacing="6">
                                                    <TextBlock Grid.Column="0" Text="{Binding ItemName}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Amount, StringFormat=¥{0:0.00}}" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding DoctorSplitSuggest, StringFormat=医生:{0}}" FontSize="11" Foreground="{DynamicResource SemiColorText2}" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding TrackDisplay}" FontSize="11" Foreground="{DynamicResource SemiColorPrimary}" VerticalAlignment="Center"/>
                                                    <ComboBox Grid.Column="4" HorizontalAlignment="Stretch"
                                                              ItemsSource="{Binding $parent[UserControl].((local:PreAdmissionViewModel)DataContext).SplitActionOptions}"
                                                              SelectedItem="{Binding FinanceSplitConfirm, Mode=TwoWay}"
                                                              IsEnabled="{Binding IsDone}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </TabItem>

                <!-- Tab 4: 管理员可配置参数与 P0/P1/P2 三级规则 -->
                <TabItem Header="4. 参数与P0/P1/P2规则配置">
                    <Border CornerRadius="8" Padding="14" Margin="0,8,0,0"
                            Background="{DynamicResource SemiColorBackground1}"
                            BorderBrush="{DynamicResource SemiColorBorder}" BorderThickness="1">
                        <ScrollViewer>
                            <StackPanel Spacing="12">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="医保预住院全局参数（管理员随时可调）" FontSize="15" FontWeight="Bold"/>
                                    <Button Grid.Column="1" Content="保存全局参数" Classes="Primary" Command="{Binding SaveConfigCommand}"/>
                                </Grid>
                                <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="8">
                                    <StackPanel Grid.Row="0" Grid.Column="0" Spacing="2">
                                        <TextBlock Text="默认预住院有效期 (天)" FontSize="11"/>
                                        <NumericUpDown Minimum="1" Maximum="60" FormatString="0" Value="{Binding CfgValidDays, Mode=TwoWay}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="1" Spacing="2">
                                        <TextBlock Text="P0危急值超时升级 (分钟)" FontSize="11"/>
                                        <NumericUpDown Minimum="5" Maximum="240" FormatString="0" Value="{Binding CfgCritEscalateMin, Mode=TwoWay}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="2" Spacing="2">
                                        <TextBlock Text="齐套未评估超时升级 (小时)" FontSize="11"/>
                                        <NumericUpDown Minimum="1" Maximum="72" FormatString="0" Value="{Binding CfgEvalEscalateHours, Mode=TwoWay}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="0" Spacing="2">
                                        <TextBlock Text="到期前预警提前量 (小时)" FontSize="11"/>
                                        <NumericUpDown Minimum="6" Maximum="168" FormatString="0" Value="{Binding CfgExpiryWarnHours, Mode=TwoWay}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="1" Spacing="2">
                                        <TextBlock Text="允许收费类别白名单" FontSize="11"/>
                                        <TextBox Text="{Binding CfgAllowedCats, Mode=TwoWay}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="2" Spacing="2">
                                        <TextBlock Text="禁收费用类别黑名单" FontSize="11"/>
                                        <TextBox Text="{Binding CfgBlockedCats, Mode=TwoWay}"/>
                                    </StackPanel>
                                </Grid>

                                <!-- 新增 P0/P1/P2 规则 -->
                                <Border Padding="8" CornerRadius="6" BorderBrush="{DynamicResource SemiColorPrimary}" BorderThickness="1">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="新增 P0/P1/P2 临床评估与抢占中断规则" FontWeight="SemiBold" FontSize="12"/>
                                        <Grid ColumnDefinitions="75,150,*,120,160,Auto" ColumnSpacing="6">
                                            <ComboBox Grid.Column="0" HorizontalAlignment="Stretch" ItemsSource="{Binding RuleLevelOptions}" SelectedItem="{Binding RuleLevel, Mode=TwoWay}"/>
                                            <TextBox Grid.Column="1" Text="{Binding RuleName, Mode=TwoWay}" PlaceholderText="规则名称"/>
                                            <TextBox Grid.Column="2" Text="{Binding RuleKeywords, Mode=TwoWay}" PlaceholderText="触发关键词（|分隔）"/>
                                            <TextBox Grid.Column="3" Text="{Binding RuleTargetDept, Mode=TwoWay}" PlaceholderText="联动B专科"/>
                                            <ComboBox Grid.Column="4" HorizontalAlignment="Stretch" ItemsSource="{Binding RuleActionOptions}" SelectedItem="{Binding RuleAction, Mode=TwoWay}"/>
                                            <Button Grid.Column="5" Content="+ 添加规则" Classes="Primary" Command="{Binding SaveRuleCommand}"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <ItemsControl ItemsSource="{Binding Rules}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="local:PreAdmissionRuleRow">
                                            <Border Padding="8,5" Margin="0,2" CornerRadius="5" BorderBrush="{DynamicResource SemiColorBorder}" BorderThickness="1">
                                                <Grid ColumnDefinitions="50,180,*,110,140,Auto" ColumnSpacing="6">
                                                    <TextBlock Grid.Column="0" Text="{Binding RuleLevel}" FontWeight="Bold" Foreground="{DynamicResource SemiColorDanger}" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding RuleName}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding MatchKeyword}" FontSize="11" Foreground="{DynamicResource SemiColorText2}" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding TargetSpecialtyDept}" FontSize="11" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="4" Text="{Binding OnHitAction}" FontSize="11" Foreground="{DynamicResource SemiColorPrimary}" VerticalAlignment="Center"/>
                                                    <Button Grid.Column="5" Content="停用" FontSize="11" Classes="Danger" Padding="6,2"
                                                            Command="{Binding $parent[UserControl].((local:PreAdmissionViewModel)DataContext).DisableRuleCommand}"
                                                            CommandParameter="{Binding}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</UserControl>
