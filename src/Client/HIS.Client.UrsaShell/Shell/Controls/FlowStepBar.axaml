<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="using:HIS.Client.UrsaShell.Shell.Controls"
             x:Class="HIS.Client.UrsaShell.Shell.Controls.FlowStepBar"
             x:Name="Root">
    <Border Background="{DynamicResource SemiColorBackground1}"
            BorderBrush="{DynamicResource SemiColorBorder}"
            BorderThickness="0,0,0,1"
            Padding="16,8">
        <Grid ColumnDefinitions="*,Auto">
            <ItemsControl Grid.Column="0" ItemsSource="{Binding #Root.Steps}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="8"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="shell:FlowStepItem">
                        <Button Classes="Tertiary"
                                Padding="8,4"
                                CornerRadius="6"
                                Command="{Binding Command}"
                                ToolTip.Tip="{Binding Tooltip}">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <Border Width="20" Height="20" CornerRadius="10"
                                        Background="{Binding BadgeBackground}">
                                    <TextBlock Text="{Binding BadgeText}"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="White"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{Binding Title}"
                                           FontSize="12"
                                           FontWeight="{Binding TitleWeight}"
                                           Foreground="{Binding TitleBrush}"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="→"
                                           FontSize="12"
                                           Foreground="{DynamicResource SemiColorText3}"
                                           IsVisible="{Binding !IsLast}"
                                           VerticalAlignment="Center"
                                           Margin="4,0,0,0"/>
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Grid.Column="1"
                       Text="{Binding #Root.BlockedReason}"
                       IsVisible="{Binding #Root.BlockedReason, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                       FontSize="11"
                       Foreground="{DynamicResource SemiColorWarning}"
                       VerticalAlignment="Center"
                       Margin="12,0,0,0"/>
        </Grid>
    </Border>
</UserControl>
