<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="HIS.Client.UrsaShell.Shell.Controls.StatusTag"
             x:Name="Root">
    <Border x:Name="TagBorder"
            CornerRadius="4"
            Padding="7,2"
            BorderThickness="1"
            VerticalAlignment="Center"
            HorizontalAlignment="Left">
        <TextBlock x:Name="TagText"
                   Text="{Binding #Root.Text}"
                   FontSize="11"
                   FontWeight="SemiBold"
                   VerticalAlignment="Center"/>
    </Border>
</UserControl>

