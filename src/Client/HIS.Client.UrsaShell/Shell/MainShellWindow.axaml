<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="using:HIS.Client.UrsaShell.Shell"
        x:Class="HIS.Client.UrsaShell.Shell.MainShellWindow"
        Title="智医 HIS · 临床与医院信息工作台"
        Width="1480" Height="920"
        MinWidth="1180" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource SemiColorBackground0}">

    <shell:MainShellView x:Name="ShellControl"/>
</Window>
