<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HIS.Client.UrsaShell.ViewModels"
             x:Class="HIS.Client.UrsaShell.Views.LoginView"
             x:DataType="vm:LoginModel"
             Background="{DynamicResource SemiColorBackground0}">

    <Grid ColumnDefinitions="340,*">
        <Border Grid.Column="0"
                Background="{DynamicResource SemiColorPrimary}"
                Padding="36">
            <Grid RowDefinitions="Auto,*,Auto">
                <StackPanel Grid.Row="0" Spacing="5">
                    <TextBlock Text="智医 HIS"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="White"/>
                    <TextBlock Text="医院信息工作台"
                               FontSize="13"
                               Foreground="White"
                               Opacity="0.78"/>
                </StackPanel>

                <StackPanel Grid.Row="1"
                            Spacing="16"
                            VerticalAlignment="Center">
                    <TextBlock Text="一个账号，可具备多个执业身份。"
                               FontSize="19"
                               FontWeight="SemiBold"
                               Foreground="White"
                               TextWrapping="Wrap"/>
                    <TextBlock Text="本次登录所选角色与科室将决定可访问的站点和业务数据范围。"
                               FontSize="13"
                               Foreground="White"
                               Opacity="0.78"
                               TextWrapping="Wrap"/>
                    <Border Height="1"
                            Background="White"
                            Opacity="0.18"
                            Margin="0,4"/>
                    <Grid ColumnDefinitions="Auto,*"
                          RowDefinitions="Auto,Auto,Auto"
                          ColumnSpacing="12"
                          RowSpacing="10">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="账号" FontSize="12" Foreground="White" Opacity="0.68"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="按工号选择，或直接输入用户名" FontSize="12" Foreground="White"/>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="角色" FontSize="12" Foreground="White" Opacity="0.68"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="门诊、住院、护理、药事或财务" FontSize="12" Foreground="White"/>
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="科室" FontSize="12" Foreground="White" Opacity="0.68"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="身份绑定科室，切换后重新加载数据" FontSize="12" Foreground="White"/>
                    </Grid>
                </StackPanel>

                <TextBlock Grid.Row="2"
                           Text="智医信息技术有限公司 © 2026"
                           FontSize="11"
                           Foreground="White"
                           Opacity="0.58"/>
            </Grid>
        </Border>

        <Border Grid.Column="1"
                Background="{DynamicResource SemiColorBackground0}"
                Padding="40,24">
            <Grid RowDefinitions="*,Auto">
                <ScrollViewer Grid.Row="0"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="18"
                                VerticalAlignment="Center"
                                MaxWidth="520"
                                HorizontalAlignment="Stretch"
                                Margin="0,8">
                        <StackPanel Spacing="4">
                            <TextBlock Text="{Binding LoginHeading}"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource SemiColorText0}"/>
                            <TextBlock Text="{Binding LoginSubheading}"
                                       FontSize="13"
                                       Foreground="{DynamicResource SemiColorText2}"/>
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="选择账号"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource SemiColorText1}"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding KnownUsers.Count, StringFormat='{}{0} 个可用账号'}"
                                           FontSize="11"
                                           Foreground="{DynamicResource SemiColorText3}"/>
                            </Grid>
                            <ListBox x:Name="AccountListBox"
                                     ItemsSource="{Binding KnownUsers}"
                                     SelectedItem="{Binding SelectedUser, Mode=TwoWay}"
                                     SelectionChanged="AccountListBox_SelectionChanged"
                                     MaxHeight="196"
                                     BorderBrush="{DynamicResource SemiColorBorder}"
                                     BorderThickness="1"
                                     CornerRadius="8"
                                     Background="{DynamicResource SemiColorBackground1}"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:LoginUserOption">
                                        <Grid ColumnDefinitions="32,*,Auto"
                                              ColumnSpacing="10"
                                              Margin="2,4">
                                            <Border Grid.Column="0"
                                                    Width="30"
                                                    Height="30"
                                                    CornerRadius="6"
                                                    Background="{DynamicResource SemiColorPrimaryLight}">
                                                <TextBlock Text="{Binding Initials}"
                                                           FontSize="12"
                                                           FontWeight="Bold"
                                                           Foreground="{DynamicResource SemiColorPrimary}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" Spacing="1">
                                                <TextBlock Text="{Binding DisplayName}"
                                                           FontSize="13"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource SemiColorText0}"/>
                                                <TextBlock FontSize="11"
                                                           Foreground="{DynamicResource SemiColorText2}">
                                                    <Run Text="{Binding EmployeeNo}"/>
                                                    <Run Text=" · "/>
                                                    <Run Text="{Binding UserName}"/>
                                                </TextBlock>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding RoleName}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource SemiColorText2}"
                                                       VerticalAlignment="Center"
                                                       MaxWidth="180"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock Text="用户名 / 工号"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource SemiColorText1}"/>
                            <TextBox Text="{Binding SelectedUserName, Mode=TwoWay}"
                                     Height="32"
                                     FontSize="12"
                                     PlaceholderText="输入用户名或工号后加载身份"/>
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="本次登录身份"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource SemiColorText1}"/>
                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            Spacing="6">
                                    <ProgressBar Width="48"
                                                 Height="3"
                                                 IsIndeterminate="True"
                                                 IsVisible="{Binding IsLoadingContexts}"
                                                 VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding ContextStatusText}"
                                               FontSize="11"
                                               Foreground="{DynamicResource SemiColorText3}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                            <Border BorderBrush="{DynamicResource SemiColorBorder}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Background="{DynamicResource SemiColorBackground1}">
                                <ListBox ItemsSource="{Binding AvailableContexts}"
                                         SelectedItem="{Binding SelectedContext, Mode=TwoWay}"
                                         MinHeight="58"
                                         MaxHeight="148"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:LoginContextOption">
                                            <Grid ColumnDefinitions="*,Auto"
                                                  ColumnSpacing="12"
                                                  Margin="2,4">
                                                <StackPanel Grid.Column="0" Spacing="2">
                                                    <TextBlock Text="{Binding RoleName}"
                                                               FontSize="12"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource SemiColorText0}"/>
                                                    <TextBlock FontSize="11"
                                                               Foreground="{DynamicResource SemiColorText2}">
                                                        <Run Text="{Binding DeptName}"/>
                                                        <Run Text=" · "/>
                                                        <Run Text="{Binding CategoryLabel}"/>
                                                    </TextBlock>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding SelectionLabel}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource SemiColorPrimary}"
                                                           VerticalAlignment="Center"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>
                            <TextBlock Text="{Binding ContextHelpText}"
                                       IsVisible="{Binding HasNoContexts}"
                                       FontSize="11"
                                       Foreground="{DynamicResource SemiColorText3}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock Text="登录密码"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource SemiColorText1}"/>
                            <TextBox x:Name="PasswordBox"
                                     Text="{Binding Password, Mode=TwoWay}"
                                     PasswordChar="●"
                                     Height="32"
                                     FontSize="12"
                                     PlaceholderText="请输入登录密码"
                                     KeyDown="Password_KeyDown"/>
                            <Border Background="{DynamicResource SemiColorDangerLight}"
                                    CornerRadius="6"
                                    Padding="10,7"
                                    IsVisible="{Binding HasError}">
                                <TextBlock Text="{Binding ErrorMessage}"
                                           Foreground="{DynamicResource SemiColorDanger}"
                                           FontSize="12"
                                           TextWrapping="Wrap"/>
                            </Border>
                        </StackPanel>

                        <Button Content="登录系统"
                                Classes="Primary"
                                Height="32"
                                IsEnabled="{Binding CanLogin}"
                                HorizontalAlignment="Stretch"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Command="{Binding LoginCommand}"
                                ToolTip.Tip="{Binding LoginBlockedReason}"/>

                        <TextBlock Text="{Binding LoginBlockedReason}"
                                   IsVisible="{Binding HasLoginBlockedReason}"
                                   FontSize="11"
                                   Foreground="{DynamicResource SemiColorText3}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>

                <TextBlock Grid.Row="1"
                           Text="智医 HIS · 临床与医院信息工作台"
                           Margin="0,14,0,0"
                           FontSize="11"
                           Foreground="{DynamicResource SemiColorText3}"
                           HorizontalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
