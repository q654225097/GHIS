<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:u="https://irihi.tech/ursa"
             xmlns:vm="using:HIS.Client.UrsaShell.ViewModels"
             x:Class="HIS.Client.UrsaShell.Views.UrsaDynamicFormPresenter"
             x:DataType="vm:WorkbenchModel">
    <Border Padding="16" Background="{DynamicResource SemiColorBackground0}" CornerRadius="8" BorderBrush="{DynamicResource SemiColorBorder}" BorderThickness="1">
        <StackPanel Spacing="14">
            <!-- Sandbox Header -->
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="{Binding SelectedFormTemplate.TemplateName, FallbackValue='心血管专病结构化随访表单'}" FontSize="16" FontWeight="Bold"/>
                    <TextBlock Text="{Binding SelectedFormTemplate.DeptScope, StringFormat='{}适用范围: {0} · 纯数据驱动 EAV 存储', FallbackValue='心血管内科 (OPD &amp; IPD)'}" FontSize="11" Foreground="{DynamicResource SemiColorText2}"/>
                </StackPanel>
                <u:Badge Grid.Column="1" Header="{Binding SelectedFormTemplate.Version, FallbackValue='v2.1'}" Classes="Primary"/>
            </Grid>

            <!-- Dynamic Schema Rule Banner -->
            <Border Background="{DynamicResource SemiColorWarningLight}" BorderBrush="{DynamicResource SemiColorWarning}" BorderThickness="1" CornerRadius="6" Padding="10,6">
                <Grid ColumnDefinitions="Auto,*">
                    <TextBlock Grid.Column="0" Text="🛡️ 门禁3 (GATE-03) 规则定义:" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource SemiColorWarning}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding SelectedFormTemplate.GenderRuleDescription, FallbackValue='前列腺触诊仅限男性 (MALE_ONLY)；孕产史仅限女性 (FEMALE_ONLY)'}" FontSize="11" Foreground="{DynamicResource SemiColorWarning}" Margin="8,0" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <u:Divider Content="患者建档与门诊专科通用扩展字段"/>

            <u:Form LabelPosition="Top">
                <Grid ColumnDefinitions="*,*">
                    <u:FormItem Grid.Column="0" Label="家庭医保共济账户授权绑定:" Margin="0,0,8,0">
                        <TextBox Text="330106198506182215" Height="32"/>
                    </u:FormItem>
                    <u:FormItem Grid.Column="1" Label="特殊慢性病种待遇认定分类:" Margin="8,0,0,0">
                        <TextBox Text="高血压 III 期 (极高危) / 冠心病" Height="32"/>
                    </u:FormItem>
                </Grid>

                <Grid ColumnDefinitions="*,*">
                    <u:FormItem Grid.Column="0" Label="冷链药品专有温度接收上限 (°C):" Margin="0,0,8,0">
                        <u:NumericDoubleUpDown Value="8.0" Minimum="0" Maximum="25" Height="32"/>
                    </u:FormItem>
                    <u:FormItem Grid.Column="1" Label="急诊绿色通道授信额度 (元):" Margin="8,0,0,0">
                        <u:NumericDoubleUpDown Value="5000.0" Minimum="0" Maximum="50000" Step="500" Height="32"/>
                    </u:FormItem>
                </Grid>

                <u:Divider Content="专科专病数据元 (GATE-03 临床性别排他规则)"/>

                <Grid ColumnDefinitions="*,*">
                    <u:FormItem Grid.Column="0" Label="前列腺触诊 [男性专属 - MALE ONLY]:" Margin="0,0,8,0">
                        <TextBox Text="{Binding EmrWorkspace.ProstateExam}" Height="32"/>
                    </u:FormItem>
                    <u:FormItem Grid.Column="1" Label="孕产次数 [女性专属 - FEMALE ONLY]:" Margin="8,0,0,0">
                        <u:NumericIntUpDown Value="{Binding EmrWorkspace.PregnancyCount}" Minimum="0" Maximum="20" Height="32"/>
                    </u:FormItem>
                </Grid>
            </u:Form>

            <!-- Bottom Action Footer -->
            <Border Background="{DynamicResource SemiColorBackground2}" CornerRadius="6" Padding="12,8">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <TextBlock Grid.Column="0" Text="EAV 存储特征:" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource SemiColorPrimary}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="零 DDL 变更扩展 · ANSI SQL 纯存储 · 前后端双向 JSON 校验" FontSize="10" Foreground="{DynamicResource SemiColorText2}" Margin="8,0" VerticalAlignment="Center"/>
                    <Button Grid.Column="2" Content="保存动态表单实例" Classes="Primary" Height="28" Padding="12,0"/>
                </Grid>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
