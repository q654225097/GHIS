<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:u="https://irihi.tech/ursa"
             x:Class="HIS.Client.UrsaShell.Views.UrsaDynamicFormPresenter">
    <Border Padding="20" Background="{DynamicResource SemiColorBackground0}">
        <StackPanel Spacing="16">
            <TextBlock Text="动态扩展字段配置中心 (CFG 模块渲染器)" FontSize="20" FontWeight="Bold"/>
            <TextBlock Text="根据服务端发布的表单 Schema 与字段定义动态生成 Ursa 组件输入槽，支持 EAV 纯数据通用存储" Foreground="{DynamicResource SemiColorText2}"/>

            <u:Divider Content="患者建档通用扩展表单 (PAT_EXT_FORM)"/>

            <u:Form LabelPosition="Top">
                <Grid ColumnDefinitions="*,*">
                    <u:FormItem Grid.Column="0" Label="家庭医保共济账户绑定:" IsRequired="False">
                        <TextBox PlaceholderText="录入共济授权人身份证号..."/>
                    </u:FormItem>
                    <u:FormItem Grid.Column="1" Label="特殊慢性病种待遇分类:">
                        <TextBox PlaceholderText="高血压 III 期 / 冠心病支架植入术后..."/>
                    </u:FormItem>
                </Grid>

                <Grid ColumnDefinitions="*,*">
                    <u:FormItem Grid.Column="0" Label="冷链药品专有温度接收上限 (°C):">
                        <u:NumericDoubleUpDown Value="8.0" Minimum="0" Maximum="25"/>
                    </u:FormItem>
                    <u:FormItem Grid.Column="1" Label="急诊绿色通道先诊疗后付费授信额度:">
                        <u:NumericDoubleUpDown Value="5000.0" Minimum="0" Maximum="50000"/>
                    </u:FormItem>
                </Grid>
            </u:Form>
        </StackPanel>
    </Border>
</UserControl>

