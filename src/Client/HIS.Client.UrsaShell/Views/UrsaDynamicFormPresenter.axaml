<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:u="https://irihi.tech/ursa"
             xmlns:vm="using:HIS.Client.UrsaShell.ViewModels"
             x:Class="HIS.Client.UrsaShell.Views.UrsaDynamicFormPresenter"
             x:DataType="vm:WorkbenchModel">
    <Border Padding="16" Background="{DynamicResource SemiColorBackground0}" CornerRadius="8" BorderBrush="{DynamicResource SemiColorBorder}" BorderThickness="1">
        <StackPanel Spacing="14">
            <!-- Sandbox Header -->
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="{Binding SelectedFormTemplate.TemplateName, FallbackValue='心血管专病结构化随访表单'}" FontSize="16" FontWeight="Bold"/>
                    <TextBlock Text="{Binding SelectedFormTemplate.DeptScope, StringFormat='{}适用范围: {0}', FallbackValue='心血管内科（门诊及住院）'}" FontSize="11" Foreground="{DynamicResource SemiColorText2}"/>
                </StackPanel>
                <u:Badge Grid.Column="1" Header="{Binding SelectedFormTemplate.Version, FallbackValue='v2.1'}" Classes="Primary"/>
            </Grid>

            <!-- Dynamic Schema Rule Banner -->
            <Border Background="{DynamicResource SemiColorWarningLight}" BorderBrush="{DynamicResource SemiColorWarning}" BorderThickness="1" CornerRadius="6" Padding="10,6">
                <Grid ColumnDefinitions="Auto,*">
                    <TextBlock Grid.Column="0" Text="字段显示规则:" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource SemiColorWarning}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding SelectedFormTemplate.GenderRuleDescription, FallbackValue='按患者性别显示相应字段'}" FontSize="11" Foreground="{DynamicResource SemiColorWarning}" Margin="8,0" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <u:Divider Content="动态表单字段"/>

            <!-- Dynamic Schema Fields -->
            <ItemsControl ItemsSource="{Binding SelectedFormTemplate.Fields}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:DynamicFormFieldModel">
                        <u:FormItem Label="{Binding FieldLabel}" IsRequired="{Binding IsRequired}"
                                    IsVisible="{Binding IsVisibleForCurrentPatient}"
                                    Width="420" Margin="0,4,16,4">
                            <Panel>
                                <!-- Text / String Control -->
                                <TextBox Text="{Binding RuntimeValue}"
                                         PlaceholderText="{Binding Placeholder}"
                                         IsEnabled="{Binding IsEditable}"
                                         IsVisible="{Binding IsTextControl}" Height="32"/>

                                <!-- Integer Control -->
                                <u:NumericIntUpDown Value="{Binding RuntimeInt}"
                                                   PlaceholderText="{Binding Placeholder}"
                                                   IsEnabled="{Binding IsEditable}"
                                                   IsVisible="{Binding IsIntegerControl}" Height="32"/>

                                <!-- Decimal Control -->
                                <u:NumericDoubleUpDown Value="{Binding RuntimeDecimal}"
                                                      PlaceholderText="{Binding Placeholder}"
                                                      IsEnabled="{Binding IsEditable}"
                                                      IsVisible="{Binding IsDecimalControl}" Height="32"/>

                                <!-- Enum / ComboBox Control -->
                                <ComboBox ItemsSource="{Binding Options}"
                                          SelectedItem="{Binding RuntimeValue}"
                                          PlaceholderText="{Binding Placeholder}"
                                          IsEnabled="{Binding IsEditable}"
                                          IsVisible="{Binding IsEnumControl}"
                                          HorizontalAlignment="Stretch" Height="32"/>

                                <!-- Boolean / CheckBox Control -->
                                <CheckBox IsChecked="{Binding RuntimeBoolean}"
                                          Content="{Binding FieldLabel}"
                                          IsEnabled="{Binding IsEditable}"
                                          IsVisible="{Binding IsBooleanControl}"/>

                                <!-- DatePicker Control -->
                                <CalendarDatePicker SelectedDate="{Binding RuntimeDate}"
                                                    IsEnabled="{Binding IsEditable}"
                                                    IsVisible="{Binding IsDateControl}"
                                                    HorizontalAlignment="Stretch" Height="32"/>
                            </Panel>
                        </u:FormItem>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Bottom Action Footer -->
            <Border Background="{DynamicResource SemiColorBackground2}" CornerRadius="6" Padding="12,8">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <TextBlock Grid.Column="0" Text="{Binding SelectedFormTemplate.FieldCount, StringFormat='{}共 {0} 个字段'}" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource SemiColorPrimary}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="字段可按需扩展，保存后继续用于该科室的病历书写" FontSize="11" Foreground="{DynamicResource SemiColorText2}" Margin="8,0" VerticalAlignment="Center"/>
                    <Button Grid.Column="2" Name="BtnSaveDynamicForm" Content="保存表单" Command="{Binding SaveDynamicFormInstanceCommand}" Classes="Primary" Height="32" Padding="12,0"/>
                </Grid>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
