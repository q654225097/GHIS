<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:HIS.Client.UrsaShell.ViewModels"
        x:Class="HIS.Client.UrsaShell.Views.MainWindow"
        x:DataType="vm:WorkbenchModel"
        Title="智医 HIS · 临床与医院信息工作台"
        Width="960"
        Height="580"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="32">
        <Border CornerRadius="12" Padding="32"
                Background="{DynamicResource SemiColorBackground1}"
                BorderBrush="{DynamicResource SemiColorBorder}" BorderThickness="1"
                VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="560">
            <StackPanel Spacing="14">
                <TextBlock Text="智医 HIS 工作台" FontSize="20" FontWeight="Bold"/>
                <TextBlock Text="从统一工作台进入门诊、住院、药事、收费、医技、病历与系统管理。"
                           FontSize="13" Foreground="{DynamicResource SemiColorText2}" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding CurrentOperatorName, StringFormat=当前账号：{0}}"
                           FontSize="12" Foreground="{DynamicResource SemiColorText1}"/>
                <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,6,0,0">
                    <Button Content="进入工作台" Classes="Primary" Height="36" Padding="18,0"
                            Command="{Binding OpenWorkspaceCommand}"/>
                    <Button Content="关闭窗口" Height="36" Padding="16,0"
                            Command="{Binding CloseWindowCommand}"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
