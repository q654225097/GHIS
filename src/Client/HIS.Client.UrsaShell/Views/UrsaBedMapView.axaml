<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:u="https://irihi.tech/ursa"
             xmlns:vm="using:HIS.Client.UrsaShell.ViewModels"
             x:Class="HIS.Client.UrsaShell.Views.UrsaBedMapView">
    <Border Padding="20" Background="{DynamicResource SemiColorBackground0}">
        <StackPanel Spacing="16">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0">
                    <TextBlock Text="内科二病区 - 物理床位矩阵看板" FontSize="20" FontWeight="Bold"/>
                    <TextBlock Text="支持本病区主收治、加床与跨科室借床 (心内一科借床患者归属心内一科查房，由本病区护士执行医嘱)" Foreground="{DynamicResource SemiColorText2}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Name="BtnBorrowBed" Content="办理跨病区借床入科" Classes="Primary"/>
                    <Button Name="BtnRefresh" Content="刷新床位图"/>
                </StackPanel>
            </Grid>

            <u:Divider Content="物理床位矩阵 (01 ~ 10 床)"/>

            <!-- UniformGrid of Beds -->
            <UniformGrid Columns="4" HorizontalAlignment="Stretch">
                <!-- Bed 01: Regular Bed -->
                <Border Margin="8" Padding="14" CornerRadius="8" Background="{DynamicResource SemiColorBackground1}" BorderBrush="{DynamicResource SemiColorBorder}" BorderThickness="1">
                    <StackPanel Spacing="6">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="01 床" FontWeight="Bold" FontSize="16"/>
                            <u:Badge Grid.Column="1" Header="占用" Classes="Success"/>
                        </Grid>
                        <TextBlock Text="患者: 刘德海 (男, 62岁)" FontWeight="SemiBold"/>
                        <TextBlock Text="住院科: 呼吸内科住院科" Foreground="{DynamicResource SemiColorText2}" FontSize="12"/>
                        <TextBlock Text="护理级别: 一级护理" Foreground="{DynamicResource SemiColorDanger}" FontSize="12"/>
                    </StackPanel>
                </Border>

                <!-- Bed 02: Cross-ward Borrowed Bed! -->
                <Border Margin="8" Padding="14" CornerRadius="8" Background="{DynamicResource SemiColorPrimaryLight}" BorderBrush="{DynamicResource SemiColorPrimary}" BorderThickness="1.5">
                    <StackPanel Spacing="6">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="02 床" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource SemiColorPrimary}"/>
                            <u:Badge Grid.Column="1" Header="跨科借床" Classes="Warning"/>
                        </Grid>
                        <TextBlock Text="患者: 赵建中 (男, 55岁)" FontWeight="SemiBold"/>
                        <TextBlock Text="医疗归属: 心血管内科住院一科" Foreground="{DynamicResource SemiColorPrimary}" FontWeight="Bold" FontSize="12"/>
                        <TextBlock Text="护理执行: 内科二病区护士站" Foreground="{DynamicResource SemiColorText2}" FontSize="12"/>
                    </StackPanel>
                </Border>

                <!-- Bed 03: Free Bed -->
                <Border Margin="8" Padding="14" CornerRadius="8" Background="{DynamicResource SemiColorBackground1}" BorderBrush="{DynamicResource SemiColorBorder}" BorderThickness="1">
                    <StackPanel Spacing="6">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="03 床" FontWeight="Bold" FontSize="16"/>
                            <u:Badge Grid.Column="1" Header="空床" Classes="Secondary"/>
                        </Grid>
                        <TextBlock Text="当前暂无患者" Foreground="{DynamicResource SemiColorText3}"/>
                        <TextBlock Text="额定床位费: ¥60.00/天" Foreground="{DynamicResource SemiColorText3}" FontSize="12"/>
                    </StackPanel>
                </Border>

                <!-- Bed 04: Free Bed -->
                <Border Margin="8" Padding="14" CornerRadius="8" Background="{DynamicResource SemiColorBackground1}" BorderBrush="{DynamicResource SemiColorBorder}" BorderThickness="1">
                    <StackPanel Spacing="6">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="04 床" FontWeight="Bold" FontSize="16"/>
                            <u:Badge Grid.Column="1" Header="空床" Classes="Secondary"/>
                        </Grid>
                        <TextBlock Text="当前暂无患者" Foreground="{DynamicResource SemiColorText3}"/>
                        <TextBlock Text="额定床位费: ¥60.00/天" Foreground="{DynamicResource SemiColorText3}" FontSize="12"/>
                    </StackPanel>
                </Border>
            </UniformGrid>
        </StackPanel>
    </Border>
</UserControl>

