{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=/var/ghis/data/his_v4.db;Mode=ReadWriteCreate;Cache=Shared"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedCorsOrigins": "https://his-client.hospital.internal;https://emr.hospital.internal",
  "HIS_CA_PROVIDER": "HttpThirdParty",
  "HIS_CA_ENDPOINT": "https://ca-gateway.hospital.internal",
  "HIS_CA_APP_ID": "${HIS_PROD_CA_APP_ID}",
  "HIS_CA_APP_SECRET": "${HIS_PROD_CA_APP_SECRET}",
  "HIS_TSA_PROVIDER": "Rfc3161Http",
  "HIS_TSA_ENDPOINT": "https://tsa.national-time-service.cn/tsp",
  "HIS_LIS_PROVIDER": "HL7",
  "HIS_LIS_SERVER": "192.168.20.50",
  "HIS_LIS_PORT": "12001",
  "HIS_PACS_PROVIDER": "Orthanc",
  "HIS_PACS_DICOMWEB_URL": "http://pacs-archive.hospital.internal:8042/dicom-web",
  "HIS_PACS_USERNAME": "${HIS_PROD_PACS_USER}",
  "HIS_PACS_PASSWORD": "${HIS_PROD_PACS_PASSWORD}",
  "HIS_HIE_PROVIDER": "FhirHttp",
  "Hie": {
    "FhirEndpointUrl": "https://hie-platform.regional-health.gov.cn/fhir/r4",
    "TimeoutMs": 8000,
    "DefaultPeerOrgCode": "ORG-REGIONAL-HIE"
  },
  "HIS_INSURANCE_PROVIDER": "Mock"
}
